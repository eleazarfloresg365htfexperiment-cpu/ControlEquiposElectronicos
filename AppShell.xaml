<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ControlEquiposElectronicos.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dashboard="clr-namespace:ControlEquiposElectronicos.Views.Dashboard"
    xmlns:equipos="clr-namespace:ControlEquiposElectronicos.Views.Equipos"
    xmlns:mantenimientos="clr-namespace:ControlEquiposElectronicos.Views.Mantenimientos"
    xmlns:checklist="clr-namespace:ControlEquiposElectronicos.Views.Checklist"
    xmlns:reportes="clr-namespace:ControlEquiposElectronicos.Views.Reportes"
    xmlns:usuarios="clr-namespace:ControlEquiposElectronicos.Views.Usuarios"
    xmlns:config="clr-namespace:ControlEquiposElectronicos.Views.Configuracion"
    Shell.FlyoutBehavior="Locked"
    FlyoutWidth="260"
    FlyoutBackgroundColor="#1E1442"
    Shell.BackgroundColor="#F4F6FA"
    Shell.ForegroundColor="White"
    Shell.TitleColor="#1A1A2E"
    Shell.TabBarIsVisible="False"
    Title="CPC">

    <!-- ═══════════════════════════════════════════ -->
    <!-- ESTILOS DEL MENÚ LATERAL                    -->
    <!-- ═══════════════════════════════════════════ -->
    <Shell.Resources>
        <ResourceDictionary>
            <Style x:Key="FlyoutItemLabelStyle" TargetType="Label">
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontSize" Value="14" />
            </Style>
        </ResourceDictionary>
    </Shell.Resources>

    <!-- Personalizar items del menú -->
    <Shell.ItemTemplate>
        <DataTemplate>
            <Grid HeightRequest="46"
                  Padding="14,0"
                  BackgroundColor="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0"
                       Source="{Binding FlyoutIcon}"
                       HeightRequest="18"
                       WidthRequest="18"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Opacity="0.85" />
                <Label Grid.Column="1"
                       Text="{Binding Title}"
                       TextColor="White"
                       FontSize="14"
                       Margin="10,0,0,0"
                       VerticalOptions="Center"
                       Opacity="0.9" />
            </Grid>
        </DataTemplate>
    </Shell.ItemTemplate>

    <!-- ═══════════════════════════════════════════ -->
    <!-- HEADER DEL SIDEBAR                          -->
    <!-- ═══════════════════════════════════════════ -->
    <Shell.FlyoutHeader>
        <Grid BackgroundColor="#1E1442" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="0">

            <!-- ZONA TOP: Logo + empresa -->
            <Grid Grid.Row="0"
                  ColumnDefinitions="Auto,*"
                  ColumnSpacing="12"
                  Padding="20,24,20,20">

                <!-- Logo CPC -->
                <Border Grid.Column="0"
                        WidthRequest="42" HeightRequest="42"
                        BackgroundColor="{StaticResource Primary}"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="0">
                    <Label Text="CPC"
                           TextColor="White"
                           FontSize="14"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <!-- Nombre empresa -->
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                    <Label Text="Centro Profesional"
                           TextColor="White"
                           FontSize="13"
                           FontAttributes="Bold" />
                    <Label Text="de Cómputo"
                           TextColor="#A78BFA"
                           FontSize="11" />
                </VerticalStackLayout>
            </Grid>

            <!-- Separador superior -->
            <BoxView Grid.Row="1"
                     HeightRequest="1"
                     BackgroundColor="#2D1F5E"
                     Margin="20,0,20,12" />

            <!-- ETIQUETAS DE SECCIÓN -->
            <Label Grid.Row="2"
                   Text="PRINCIPAL"
                   TextColor="#6B7280"
                   FontSize="10"
                   FontAttributes="Bold"
                   CharacterSpacing="1.5"
                   Margin="22,0,0,8" />

        </Grid>
    </Shell.FlyoutHeader>

    <!-- ═══════════════════════════════════════════ -->
    <!-- ITEMS DEL MENÚ                              -->
    <!-- ═══════════════════════════════════════════ -->
    <FlyoutItem Title="Dashboard" Route="Dashboard">
        <FlyoutItem.Icon>
            <FontImageSource FontFamily="FontAwesome" Glyph="&#xf015;" Color="White" Size="16" />
        </FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate dashboard:DashboardPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Equipos" Route="Equipos">
        <FlyoutItem.Icon>
            <FontImageSource FontFamily="FontAwesome" Glyph="&#xf108;" Color="White" Size="16" />
        </FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate equipos:EquiposPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Mantenimientos" Route="Mantenimientos">
        <FlyoutItem.Icon>
            <FontImageSource FontFamily="FontAwesome" Glyph="&#xf0ad;" Color="White" Size="16" />
        </FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate mantenimientos:MantenimientosPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Checklist" Route="Checklist">
        <FlyoutItem.Icon>
            <FontImageSource FontFamily="FontAwesome" Glyph="&#xf46c;" Color="White" Size="16" />
        </FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate checklist:ChecklistPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Reportes" Route="Reportes">
        <FlyoutItem.Icon>
            <FontImageSource FontFamily="FontAwesome" Glyph="&#xf15c;" Color="White" Size="16" />
        </FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate reportes:ReportesPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Usuarios" Route="Usuarios">
        <FlyoutItem.Icon>
            <FontImageSource FontFamily="FontAwesome" Glyph="&#xf0c0;" Color="White" Size="16" />
        </FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate usuarios:UsuariosPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Configuración" Route="Configuracion">
        <FlyoutItem.Icon>
            <FontImageSource FontFamily="FontAwesome" Glyph="&#xf013;" Color="White" Size="16" />
        </FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate config:ConfiguracionPage}" />
    </FlyoutItem>

    <!-- ═══════════════════════════════════════════ -->
    <!-- FOOTER DEL SIDEBAR: perfil + cerrar sesión  -->
    <!-- ═══════════════════════════════════════════ -->
    <Shell.FlyoutFooter>
        <VerticalStackLayout BackgroundColor="#1E1442" Padding="0,8,0,0" Spacing="0">

            <!-- Separador -->
            <BoxView HeightRequest="1"
                     BackgroundColor="#2D1F5E"
                     Margin="20,0,20,10" />

            <!-- TARJETA DEL USUARIO (tappable) -->
            <Grid Padding="16,10,16,10"
                  ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="10">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMenuUsuarioTapped" />
                </Grid.GestureRecognizers>

                <!-- Avatar circular con iniciales -->
                <Border Grid.Column="0"
                        WidthRequest="38" HeightRequest="38"
                        BackgroundColor="{StaticResource Primary}"
                        StrokeShape="RoundRectangle 19"
                        StrokeThickness="2"
                        Stroke="#A78BFA">
                    <Label x:Name="InicialesLabel"
                           Text="??"
                           TextColor="White"
                           FontSize="13"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <!-- Nombre y rol -->
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                    <Label x:Name="NombreUsuarioLabel"
                           Text="Usuario"
                           TextColor="White"
                           FontSize="13"
                           FontAttributes="Bold"
                           LineBreakMode="TailTruncation" />
                    <Label x:Name="RolUsuarioLabel"
                           Text="Rol"
                           TextColor="#A78BFA"
                           FontSize="11" />
                </VerticalStackLayout>

                <!-- Flecha -->
                <Label Grid.Column="2"
                       x:Name="FlechaMenuLabel"
                       Text="&#x25BE;"
                       TextColor="#A78BFA"
                       FontSize="12"
                       VerticalOptions="Center" />
            </Grid>

            <!-- MENÚ DESPLEGABLE DEL USUARIO -->
            <VerticalStackLayout x:Name="MenuUsuarioDesplegable"
                                 IsVisible="False"
                                 Padding="14,0,14,8"
                                 Spacing="4">

                <!-- Mi perfil -->
                <Border BackgroundColor="#2D1F5E"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="0"
                        Padding="14,10">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMiPerfilTapped" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Grid.Column="0"
                                WidthRequest="28" HeightRequest="28"
                                BackgroundColor="{StaticResource Primary}"
                                StrokeShape="RoundRectangle 8"
                                StrokeThickness="0">
                            <Label FontFamily="FontAwesome"
                                   Text="&#xf007;"
                                   TextColor="White"
                                   FontSize="12"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                            <Label Text="Mi perfil"
                                   TextColor="White"
                                   FontSize="13"
                                   FontAttributes="Bold" />
                            <Label Text="Ver tu información"
                                   TextColor="#A78BFA"
                                   FontSize="11" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

            </VerticalStackLayout>

            <!-- CERRAR SESIÓN — siempre visible -->
            <Border BackgroundColor="#2D0A0A"
                    StrokeShape="RoundRectangle 10"
                    StrokeThickness="1"
                    Stroke="#5C1A1A"
                    Padding="14,10"
                    Margin="14,4,14,16">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCerrarSesionTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border Grid.Column="0"
                            WidthRequest="28" HeightRequest="28"
                            BackgroundColor="#8B0000"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="0">
                        <Label FontFamily="FontAwesome"
                               Text="&#xf2f5;"
                               TextColor="White"
                               FontSize="12"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                        <Label Text="Cerrar sesión"
                               TextColor="#FF6B6B"
                               FontSize="13"
                               FontAttributes="Bold" />
                        <Label Text="Salir de tu cuenta"
                               TextColor="#FF9999"
                               FontSize="11" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

        </VerticalStackLayout>
    </Shell.FlyoutFooter>

</Shell>
