<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ControlEquiposElectronicos.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dashboard="clr-namespace:ControlEquiposElectronicos.Views.Dashboard"
    xmlns:equipos="clr-namespace:ControlEquiposElectronicos.Views.Equipos"
    xmlns:mantenimientos="clr-namespace:ControlEquiposElectronicos.Views.Mantenimientos"
    xmlns:checklist="clr-namespace:ControlEquiposElectronicos.Views.Checklist"
    xmlns:reportes="clr-namespace:ControlEquiposElectronicos.Views.Reportes"
    xmlns:usuarios="clr-namespace:ControlEquiposElectronicos.Views.Usuarios"
    xmlns:config="clr-namespace:ControlEquiposElectronicos.Views.Configuracion"
    Shell.FlyoutBehavior="Locked"
    FlyoutWidth="240"
    FlyoutBackgroundColor="{StaticResource Primary}"
    Shell.BackgroundColor="{StaticResource Gray100}"
    Shell.ForegroundColor="{StaticResource Primary}"
    Shell.TitleColor="{StaticResource Gray900}"
    Title="Control de Equipos CPC">

    <Shell.FlyoutHeader>
        <Grid BackgroundColor="{StaticResource Tertiary}" Padding="20,30,20,16" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnMenuUsuarioTapped" />
            </Grid.GestureRecognizers>

            <Border
                Grid.Row="0"
                WidthRequest="60"
                HeightRequest="60"
                HorizontalOptions="Start"
                BackgroundColor="White"
                StrokeShape="RoundRectangle 14"
                StrokeThickness="0">
                <Label
                    Text="CPC"
                    TextColor="{StaticResource Primary}"
                    FontSize="20"
                    FontAttributes="Bold"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                <Label
                    Grid.Column="0"
                    x:Name="NombreUsuarioLabel"
                    Text="Usuario"
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    VerticalOptions="Center" />
                <Label
                    Grid.Column="1"
                    x:Name="FlechaMenuLabel"
                    Text="&#x25BE;"
                    TextColor="White"
                    FontSize="14"
                    VerticalOptions="Center"
                    Margin="6,0,0,0" />
            </Grid>

            <Label
                Grid.Row="2"
                x:Name="RolUsuarioLabel"
                Text="Rol"
                TextColor="{StaticResource Secondary}"
                FontSize="13" />

            <!-- Mini-menú desplegable: opciones que aparecen al tocar -->
            <VerticalStackLayout Grid.Row="3"
                                 x:Name="MenuUsuarioDesplegable"
                                 IsVisible="False"
                                 Margin="0,14,0,0"
                                 Spacing="2">

                <Border BackgroundColor="#3A1F8F"
                        StrokeShape="RoundRectangle 6"
                        StrokeThickness="0"
                        Padding="10,8">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMiPerfilTapped" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Grid.Column="0"
                               FontFamily="FontAwesome"
                               Text="&#xf007;"
                               TextColor="White"
                               FontSize="14"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="Mi perfil"
                               TextColor="White"
                               FontSize="14"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Border BackgroundColor="#3A1F8F"
                        StrokeShape="RoundRectangle 6"
                        StrokeThickness="0"
                        Padding="10,8">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCerrarSesionTapped" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Grid.Column="0"
                               FontFamily="FontAwesome"
                               Text="&#xf2f5;"
                               TextColor="White"
                               FontSize="14"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="Cerrar sesión"
                               TextColor="White"
                               FontSize="14"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

            </VerticalStackLayout>

        </Grid>
    </Shell.FlyoutHeader>

    <FlyoutItem Title="Dashboard" Route="Dashboard">
        <FlyoutItem.Icon>
            <FontImageSource FontFamily="FontAwesome" Glyph="&#xf015;" Color="White" Size="18" />
        </FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate dashboard:DashboardPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Equipos" Route="Equipos">

        <Tab Title="General">
            <ShellContent Title="Equipos"
                          ContentTemplate="{DataTemplate equipos:EquiposPage}" />
        </Tab>
        <Tab Title="🌐 Red">
            <ShellContent Title="Red"
                          ContentTemplate="{DataTemplate equipos:RedPage}" />
        </Tab>
        <Tab Title="🖨️ Impresión">
            <ShellContent Title="Impresión"
                          ContentTemplate="{DataTemplate equipos:ImpresionPage}" />
        </Tab>
        <Tab Title="⚡ Electricidad">
            <ShellContent Title="Electricidad"
                          ContentTemplate="{DataTemplate equipos:ElectricidadPage}" />
        </Tab>
        <Tab Title="🌿 Soporte Ambiental">
            <ShellContent Title="Soporte Ambiental"
                          ContentTemplate="{DataTemplate equipos:SoporteAmbientalPage}" />
        </Tab>

        <FlyoutItem.Icon>
            <FontImageSource FontFamily="FontAwesome" Glyph="&#xf108;" Color="White" Size="18" />
        </FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate equipos:EquiposPage}" />
