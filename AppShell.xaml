<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ControlEquiposElectronicos.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dashboard="clr-namespace:ControlEquiposElectronicos.Views.Dashboard"
    xmlns:equipos="clr-namespace:ControlEquiposElectronicos.Views.Equipos"
    xmlns:mantenimientos="clr-namespace:ControlEquiposElectronicos.Views.Mantenimientos"
    xmlns:checklist="clr-namespace:ControlEquiposElectronicos.Views.Checklist"
    xmlns:reportes="clr-namespace:ControlEquiposElectronicos.Views.Reportes"
    xmlns:usuarios="clr-namespace:ControlEquiposElectronicos.Views.Usuarios"
    xmlns:config="clr-namespace:ControlEquiposElectronicos.Views.Configuracion"
    Shell.FlyoutBehavior="Locked"
    FlyoutWidth="240"
    FlyoutBackgroundColor="{StaticResource Tertiary}"
    Shell.BackgroundColor="#F4F6FA"
    Shell.ForegroundColor="White"
    Shell.TitleColor="#1A1A2E"
    Title="CPC">

    <Shell.ItemTemplate>
        <DataTemplate>
            <Grid HeightRequest="0" IsVisible="False" />
        </DataTemplate>
    </Shell.ItemTemplate>

    <Shell.FlyoutHeader>
        <VerticalStackLayout BackgroundColor="{StaticResource Tertiary}" Spacing="0">

            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8" Padding="10,16,12,12">
                <Border Grid.Column="0" WidthRequest="34" HeightRequest="34"
                        BackgroundColor="#3D1F8F" StrokeShape="RoundRectangle 8" StrokeThickness="0"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnToggleSidebar" />
                    </Border.GestureRecognizers>
                    <Label FontFamily="FontAwesome" Text="&#xf0c9;" TextColor="White" FontSize="14"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <Border Grid.Column="1" x:Name="LogoCPC" WidthRequest="34" HeightRequest="34"
                        BackgroundColor="{StaticResource Primary}" StrokeShape="RoundRectangle 8"
                        StrokeThickness="0" VerticalOptions="Center">
                    <Label Text="CPC" TextColor="White" FontSize="11" FontAttributes="Bold"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <VerticalStackLayout Grid.Column="2" x:Name="NombreEmpresaStack"
                                     VerticalOptions="Center" Spacing="0" Margin="4,0,0,0">
                    <Label Text="Centro Profesional" TextColor="White" FontSize="11" FontAttributes="Bold" LineBreakMode="NoWrap" />
                    <Label Text="de Cómputo" TextColor="#A78BFA" FontSize="10" LineBreakMode="NoWrap" />
                </VerticalStackLayout>
            </Grid>

            <BoxView HeightRequest="1" BackgroundColor="#3D1F8F" Margin="10,0,10,0" />

            <Label x:Name="LabelPrincipal" Text="PRINCIPAL" TextColor="#A78BFA"
                   FontSize="9" FontAttributes="Bold" CharacterSpacing="1.2"
                   Margin="12,10,0,3" LineBreakMode="NoWrap" />

            <Border x:Name="BtnDashboard" BackgroundColor="{StaticResource Primary}"
                    StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="8,9" Margin="6,0,6,1">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDashboardTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="20,*" ColumnSpacing="8">
                    <Label FontFamily="FontAwesome" Text="&#xf015;" TextColor="White"
                           FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />
                    <Label x:Name="LblDashboard" Grid.Column="1" Text="Dashboard"
                           TextColor="White" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" LineBreakMode="NoWrap" />
                </Grid>
            </Border>

            <Border x:Name="BtnEquipos" BackgroundColor="Transparent"
                    StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="8,9" Margin="6,0,6,1">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnEquiposTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="20,*" ColumnSpacing="8">
                    <Label FontFamily="FontAwesome" Text="&#xf108;" TextColor="#A78BFA"
                           FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />
                    <Label x:Name="LblEquipos" Grid.Column="1" Text="Equipos"
                           TextColor="#C4B5FD" FontSize="13" VerticalOptions="Center" LineBreakMode="NoWrap" />
                </Grid>
            </Border>

            <Border x:Name="BtnMantenimientos" BackgroundColor="Transparent"
                    StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="8,9" Margin="6,0,6,1">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMantenimientosTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="20,*" ColumnSpacing="8">
                    <Label FontFamily="FontAwesome" Text="&#xf0ad;" TextColor="#A78BFA"
                           FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />
                    <Label x:Name="LblMantenimientos" Grid.Column="1" Text="Mantenimientos"
                           TextColor="#C4B5FD" FontSize="13" VerticalOptions="Center" LineBreakMode="NoWrap" />
                </Grid>
            </Border>

            <Label x:Name="LabelGestion" Text="GESTIÓN" TextColor="#A78BFA"
                   FontSize="9" FontAttributes="Bold" CharacterSpacing="1.2"
                   Margin="12,10,0,3" LineBreakMode="NoWrap" />

            <Border x:Name="BtnChecklist" BackgroundColor="Transparent"
                    StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="8,9" Margin="6,0,6,1">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnChecklistTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="20,*" ColumnSpacing="8">
                    <Label FontFamily="FontAwesome" Text="&#xf46c;" TextColor="#A78BFA"
                           FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />
                    <Label x:Name="LblChecklist" Grid.Column="1" Text="Checklist"
                           TextColor="#C4B5FD" FontSize="13" VerticalOptions="Center" LineBreakMode="NoWrap" />
                </Grid>
            </Border>

            <Border x:Name="BtnReportes" BackgroundColor="Transparent"
                    StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="8,9" Margin="6,0,6,1">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnReportesTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="20,*" ColumnSpacing="8">
                    <Label FontFamily="FontAwesome" Text="&#xf15c;" TextColor="#A78BFA"
                           FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />
                    <Label x:Name="LblReportes" Grid.Column="1" Text="Reportes"
                           TextColor="#C4B5FD" FontSize="13" VerticalOptions="Center" LineBreakMode="NoWrap" />
                </Grid>
            </Border>

            <Border x:Name="BtnUsuarios" BackgroundColor="Transparent"
                    StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="8,9" Margin="6,0,6,1">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnUsuariosTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="20,*" ColumnSpacing="8">
                    <Label FontFamily="FontAwesome" Text="&#xf0c0;" TextColor="#A78BFA"
                           FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />
                    <Label x:Name="LblUsuarios" Grid.Column="1" Text="Usuarios"
                           TextColor="#C4B5FD" FontSize="13" VerticalOptions="Center" LineBreakMode="NoWrap" />
                </Grid>
            </Border>

            <Label x:Name="LabelSistema" Text="SISTEMA" TextColor="#A78BFA"
                   FontSize="9" FontAttributes="Bold" CharacterSpacing="1.2"
                   Margin="12,10,0,3" LineBreakMode="NoWrap" />

            <Border x:Name="BtnConfiguracion" BackgroundColor="Transparent"
                    StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="8,9" Margin="6,0,6,8">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnConfiguracionTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="20,*" ColumnSpacing="8">
                    <Label FontFamily="FontAwesome" Text="&#xf013;" TextColor="#A78BFA"
                           FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />
                    <Label x:Name="LblConfiguracion" Grid.Column="1" Text="Configuración"
                           TextColor="#C4B5FD" FontSize="13" VerticalOptions="Center" LineBreakMode="NoWrap" />
                </Grid>
            </Border>

        </VerticalStackLayout>
    </Shell.FlyoutHeader>

    <Shell.FlyoutFooter>
        <VerticalStackLayout BackgroundColor="{StaticResource Tertiary}" Spacing="0">
            <BoxView HeightRequest="1" BackgroundColor="#3D1F8F" Margin="10,0,10,8" />

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="12,8,12,8">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMenuUsuarioTapped" />
                </Grid.GestureRecognizers>
                <Border Grid.Column="0" WidthRequest="36" HeightRequest="36"
                        BackgroundColor="{StaticResource Primary}"
                        StrokeShape="RoundRectangle 18" StrokeThickness="2" Stroke="#A78BFA">
                    <Label x:Name="InicialesLabel" Text="??" TextColor="White"
                           FontSize="12" FontAttributes="Bold"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" x:Name="NombreUsuarioStack"
                                     VerticalOptions="Center" Spacing="1">
                    <Label x:Name="NombreUsuarioLabel" Text="Usuario" TextColor="White"
                           FontSize="13" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                    <Label x:Name="RolUsuarioLabel" Text="Rol" TextColor="#A78BFA" FontSize="11" />
                </VerticalStackLayout>
                <Label Grid.Column="2" x:Name="FlechaMenuLabel" Text="&#x25BE;"
                       TextColor="#A78BFA" FontSize="12" VerticalOptions="Center" />
            </Grid>

            <VerticalStackLayout x:Name="MenuUsuarioDesplegable"
                                 IsVisible="False" Padding="10,0,10,4" Spacing="4">
                <Border BackgroundColor="#3D1F8F" StrokeShape="RoundRectangle 8"
                        StrokeThickness="0" Padding="12,9">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMiPerfilTapped" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="26,*" ColumnSpacing="10">
                        <Border Grid.Column="0" WidthRequest="26" HeightRequest="26"
                                BackgroundColor="{StaticResource Primary}"
                                StrokeShape="RoundRectangle 7" StrokeThickness="0">
                            <Label FontFamily="FontAwesome" Text="&#xf007;" TextColor="White"
                                   FontSize="11" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                            <Label Text="Mi perfil" TextColor="White" FontSize="13" FontAttributes="Bold" />
                            <Label Text="Ver tu información" TextColor="#A78BFA" FontSize="10" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border BackgroundColor="#3D0A0A" StrokeShape="RoundRectangle 8"
                        StrokeThickness="1" Stroke="#6B1A1A" Padding="12,9">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCerrarSesionTapped" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="26,*" ColumnSpacing="10">
                        <Border Grid.Column="0" WidthRequest="26" HeightRequest="26"
                                BackgroundColor="#8B0000"
                                StrokeShape="RoundRectangle 7" StrokeThickness="0">
                            <Label FontFamily="FontAwesome" Text="&#xf2f5;" TextColor="White"
                                   FontSize="11" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                            <Label Text="Cerrar sesión" TextColor="#FF6B6B" FontSize="13" FontAttributes="Bold" />
                            <Label Text="Salir de tu cuenta" TextColor="#FF9999" FontSize="10" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <BoxView HeightRequest="8" BackgroundColor="Transparent" />
        </VerticalStackLayout>
    </Shell.FlyoutFooter>

    <FlyoutItem Title="Dashboard" Route="Dashboard">
        <ShellContent ContentTemplate="{DataTemplate dashboard:DashboardPage}" />
    </FlyoutItem>

    <!-- Equipos: navegación interna manejada por EquiposPage con tabs custom -->
    <FlyoutItem Title="Equipos" Route="Equipos">
        <ShellContent ContentTemplate="{DataTemplate equipos:EquiposPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Mantenimientos" Route="Mantenimientos">
        <ShellContent ContentTemplate="{DataTemplate mantenimientos:MantenimientosPage}" />
    </FlyoutItem>
    <FlyoutItem Title="Checklist" Route="Checklist">
        <ShellContent ContentTemplate="{DataTemplate checklist:ChecklistPage}" />
    </FlyoutItem>
    <FlyoutItem Title="Reportes" Route="Reportes">
        <ShellContent ContentTemplate="{DataTemplate reportes:ReportesPage}" />
    </FlyoutItem>
    <FlyoutItem Title="Usuarios" Route="Usuarios">
        <ShellContent ContentTemplate="{DataTemplate usuarios:UsuariosPage}" />
    </FlyoutItem>
    <FlyoutItem Title="Configuración" Route="Configuracion">
        <ShellContent ContentTemplate="{DataTemplate config:ConfiguracionPage}" />
    </FlyoutItem>

</Shell>
