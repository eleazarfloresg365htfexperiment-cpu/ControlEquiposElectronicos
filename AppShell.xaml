<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ControlEquiposElectronicos.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dashboard="clr-namespace:ControlEquiposElectronicos.Views.Dashboard"
    xmlns:equipos="clr-namespace:ControlEquiposElectronicos.Views.Equipos"
    xmlns:mantenimientos="clr-namespace:ControlEquiposElectronicos.Views.Mantenimientos"
    xmlns:reportes="clr-namespace:ControlEquiposElectronicos.Views.Reportes"
    xmlns:usuarios="clr-namespace:ControlEquiposElectronicos.Views.Usuarios"
    xmlns:config="clr-namespace:ControlEquiposElectronicos.Views.Configuracion"
    Shell.FlyoutBehavior="Flyout"
    Title="Control de Equipos CPC">

    <FlyoutItem Title="Dashboard" Route="Dashboard">
        <ShellContent ContentTemplate="{DataTemplate dashboard:DashboardPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Equipos" Route="Equipos">
        <ShellContent ContentTemplate="{DataTemplate equipos:EquiposPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Mantenimientos" Route="Mantenimientos">
        <ShellContent ContentTemplate="{DataTemplate mantenimientos:MantenimientosPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Reportes" Route="Reportes">
        <ShellContent ContentTemplate="{DataTemplate reportes:ReportesPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Usuarios" Route="Usuarios">
        <ShellContent ContentTemplate="{DataTemplate usuarios:UsuariosPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Configuración" Route="Configuracion">
        <ShellContent ContentTemplate="{DataTemplate config:ConfiguracionPage}" />
    </FlyoutItem>
    <FlyoutItem Title="🌐 Red" Route="Red">
        <ShellContent ContentTemplate="{DataTemplate equipos:RedPage}" />
    </FlyoutItem>

    <FlyoutItem Title="🖨️ Impresión" Route="Impresion">
        <ShellContent ContentTemplate="{DataTemplate equipos:ImpresionPage}" />
    </FlyoutItem>

    <FlyoutItem Title="⚡ Electricidad" Route="Electricidad">
        <ShellContent ContentTemplate="{DataTemplate equipos:ElectricidadPage}" />
    </FlyoutItem>

    <FlyoutItem Title="🌿 Soporte Ambiental" Route="SoporteAmbiental">
        <ShellContent ContentTemplate="{DataTemplate equipos:SoporteAmbientalPage}" />
    </FlyoutItem>

</Shell>