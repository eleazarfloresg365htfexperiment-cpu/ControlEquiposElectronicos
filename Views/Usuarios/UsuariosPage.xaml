<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ControlEquiposElectronicos.Views.Usuarios.UsuariosPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dtos="clr-namespace:ControlEquiposElectronicos.DTOs.Usuarios"
    Title=""
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F5F6FA">

    <!-- Grid raíz: contenido + overlay superpuesto en la misma celda -->
    <Grid>

        <!-- ══ CONTENIDO PRINCIPAL DE USUARIOS ══ -->
        <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="28,24,28,0" RowSpacing="0">

            <!-- ══════════════════════════════════════════ -->
            <!-- HEADER                                      -->
            <!-- ══════════════════════════════════════════ -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="10" Margin="0,0,0,24">

                <!-- Título + subtítulo -->
                <VerticalStackLayout Grid.Column="0" Spacing="3" VerticalOptions="Center">
                    <Label Text="Usuarios" FontSize="26" FontAttributes="Bold" TextColor="#1A1F3A"/>
                    <Label Text="Gestiona las cuentas del sistema y permisos"
                       FontSize="13" TextColor="#9AA3BE"/>
                </VerticalStackLayout>

                <!-- Buscador -->
                <Border Grid.Column="1"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 12"
                    Stroke="#E8E4F8" StrokeThickness="1"
                    Padding="12,0" WidthRequest="220"
                    VerticalOptions="Center">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Label Grid.Column="0" FontFamily="FontAwesome" Text="&#xf002;"
                           FontSize="13" TextColor="#9AA3BE" VerticalOptions="Center"/>
                        <Entry Grid.Column="1"
                           x:Name="BusquedaEntry"
                           Placeholder="Buscar usuario..."
                           TextChanged="OnBusquedaTextChanged"
                           TextColor="#1A1F3A"
                           PlaceholderColor="#C4C9D8"
                           HeightRequest="42"
                           BackgroundColor="Transparent"/>
                    </Grid>
                </Border>

                <!-- Botón Gestionar permisos por rol -->
                <Border Grid.Column="2"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="1" Stroke="#E8E4F8"
                    Padding="14,10"
                    VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPermisosRolTapped"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="8">
                        <Label FontFamily="FontAwesome" Text="&#xf084;"
                           FontSize="13" TextColor="#512BD4" VerticalOptions="Center"/>
                        <Label Text="Permisos por rol" FontSize="13" FontAttributes="Bold"
                           TextColor="#512BD4" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Botón Gestionar roles por usuario -->
                <Border Grid.Column="3"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="1" Stroke="#E8E4F8"
                    Padding="14,10"
                    VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRolesUsuarioTapped"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="8">
                        <Label FontFamily="FontAwesome" Text="&#xf0c0;"
                           FontSize="13" TextColor="#512BD4" VerticalOptions="Center"/>
                        <Label Text="Roles por usuario" FontSize="13" FontAttributes="Bold"
                           TextColor="#512BD4" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Botón + Nuevo usuario -->
                <Border Grid.Column="4"
                    BackgroundColor="#512BD4"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="0"
                    Padding="16,10"
                    VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNuevoUsuarioTapped"/>
                    </Border.GestureRecognizers>
                    <Border.Shadow>
                        <Shadow Brush="#40512BD4" Offset="0,4" Radius="12" Opacity="1"/>
                    </Border.Shadow>
                    <HorizontalStackLayout Spacing="8">
                        <Label FontFamily="FontAwesome" Text="&#xf067;"
                           FontSize="13" TextColor="White" VerticalOptions="Center"/>
                        <Label Text="Nuevo usuario" FontSize="13" FontAttributes="Bold"
                           TextColor="White" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

            </Grid>

            <!-- ══════════════════════════════════════════ -->
            <!-- TARJETAS DE ESTADÍSTICAS                   -->
            <!-- ══════════════════════════════════════════ -->
            <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="14" Margin="0,0,0,24">

                <!-- Total usuarios -->
                <Border Grid.Column="0" BackgroundColor="White"
                    StrokeShape="RoundRectangle 14" Stroke="#EEEBf8"
                    StrokeThickness="1" Padding="18,16">
                    <Border.Shadow>
                        <Shadow Brush="#10512BD4" Offset="0,3" Radius="12" Opacity="1"/>
                    </Border.Shadow>
                    <HorizontalStackLayout Spacing="16">
                        <Border BackgroundColor="#EDE9FB" StrokeShape="RoundRectangle 22"
                            StrokeThickness="0" WidthRequest="44" HeightRequest="44">
                            <Label FontFamily="FontAwesome" Text="&#xf0c0;"
                               FontSize="18" TextColor="#512BD4"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label x:Name="LblTotal" Text="0"
                               FontSize="24" FontAttributes="Bold" TextColor="#1A1F3A"/>
                            <Label Text="Total usuarios" FontSize="11" TextColor="#9AA3BE"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Border>

                <!-- Administradores -->
                <Border Grid.Column="1" BackgroundColor="White"
                    StrokeShape="RoundRectangle 14" Stroke="#EEEBf8"
                    StrokeThickness="1" Padding="18,16">
                    <Border.Shadow>
                        <Shadow Brush="#10512BD4" Offset="0,3" Radius="12" Opacity="1"/>
                    </Border.Shadow>
                    <HorizontalStackLayout Spacing="16">
                        <Border BackgroundColor="#EBF4FF" StrokeShape="RoundRectangle 22"
                            StrokeThickness="0" WidthRequest="44" HeightRequest="44">
                            <Label FontFamily="FontAwesome" Text="&#xf505;"
                               FontSize="18" TextColor="#1E40AF"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label x:Name="LblAdmins" Text="0"
                               FontSize="24" FontAttributes="Bold" TextColor="#1A1F3A"/>
                            <Label Text="Administradores" FontSize="11" TextColor="#9AA3BE"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Border>

                <!-- Activos -->
                <Border Grid.Column="2" BackgroundColor="White"
                    StrokeShape="RoundRectangle 14" Stroke="#EEEBf8"
                    StrokeThickness="1" Padding="18,16">
                    <Border.Shadow>
                        <Shadow Brush="#10512BD4" Offset="0,3" Radius="12" Opacity="1"/>
                    </Border.Shadow>
                    <HorizontalStackLayout Spacing="16">
                        <Border BackgroundColor="#DCFCE7" StrokeShape="RoundRectangle 22"
                            StrokeThickness="0" WidthRequest="44" HeightRequest="44">
                            <Label FontFamily="FontAwesome" Text="&#xf058;"
                               FontSize="18" TextColor="#15803D"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label x:Name="LblActivos" Text="0"
                               FontSize="24" FontAttributes="Bold" TextColor="#1A1F3A"/>
                            <Label Text="Usuarios activos" FontSize="11" TextColor="#9AA3BE"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Border>

                <!-- Inactivos -->
                <Border Grid.Column="3" BackgroundColor="White"
                    StrokeShape="RoundRectangle 14" Stroke="#EEEBf8"
                    StrokeThickness="1" Padding="18,16">
                    <Border.Shadow>
                        <Shadow Brush="#10512BD4" Offset="0,3" Radius="12" Opacity="1"/>
                    </Border.Shadow>
                    <HorizontalStackLayout Spacing="16">
                        <Border BackgroundColor="#FEE2E2" StrokeShape="RoundRectangle 22"
                            StrokeThickness="0" WidthRequest="44" HeightRequest="44">
                            <Label FontFamily="FontAwesome" Text="&#xf057;"
                               FontSize="18" TextColor="#991B1B"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label x:Name="LblInactivos" Text="0"
                               FontSize="24" FontAttributes="Bold" TextColor="#1A1F3A"/>
                            <Label Text="Usuarios inactivos" FontSize="11" TextColor="#9AA3BE"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Border>

            </Grid>

            <!-- ══════════════════════════════════════════ -->
            <!-- INDICADOR DE CARGA                          -->
            <!-- ══════════════════════════════════════════ -->
            <ActivityIndicator Grid.Row="2"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           Color="#512BD4"
                           HorizontalOptions="Center"
                           Margin="0,0,0,12"/>

            <!-- ══════════════════════════════════════════ -->
            <!-- GRID DE TARJETAS DE USUARIOS               -->
            <!-- ══════════════════════════════════════════ -->
            <CollectionView Grid.Row="3"
                        x:Name="UsuariosCollection"
                        ItemsSource="{Binding Usuarios}">

                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                        <Label FontFamily="FontAwesome" Text="&#xf0c0;"
                           FontSize="36" TextColor="#D1D5E8" HorizontalOptions="Center"/>
                        <Label Text="No hay usuarios para mostrar."
                           FontSize="14" TextColor="#9AA3BE" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="3"
                                 HorizontalItemSpacing="14" VerticalItemSpacing="14"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dtos:UsuarioListadoDto">
                        <Border BackgroundColor="White"
                            Padding="20"
                            StrokeShape="RoundRectangle 16"
                            Stroke="#EEEBf8" StrokeThickness="1">
                            <Border.Shadow>
                                <Shadow Brush="#12512BD4" Offset="0,3" Radius="14" Opacity="1"/>
                            </Border.Shadow>

                            <VerticalStackLayout Spacing="12">

                                <!-- Fila superior: avatar + nombre + badge rol -->
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">

                                    <!-- Avatar circular con inicial -->
                                    <Border Grid.Column="0"
                                        WidthRequest="52" HeightRequest="52"
                                        BackgroundColor="#EDE9FB"
                                        StrokeShape="RoundRectangle 26"
                                        StrokeThickness="2" Stroke="#C4B5FD"
                                        VerticalOptions="Start">
                                        <Label FontFamily="FontAwesome" Text="&#xf007;"
                                           FontSize="20" TextColor="#512BD4"
                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>

                                    <!-- Nombre, nick y badge de rol -->
                                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                        <Label Text="{Binding NombreCompleto}"
                                           FontSize="14" FontAttributes="Bold"
                                           TextColor="#1A1F3A" LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding Nickname, StringFormat='@{0}'}"
                                           FontSize="12" TextColor="#9AA3BE"/>

                                        <!-- Badge de rol dinámico -->
                                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 6"
                                            Padding="8,3" HorizontalOptions="Start">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border"
                                                         Binding="{Binding Rol}" Value="Administrador">
                                                    <Setter Property="BackgroundColor" Value="#EDE9FB"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border"
                                                         Binding="{Binding Rol}" Value="OP">
                                                    <Setter Property="BackgroundColor" Value="#DBEAFE"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border"
                                                         Binding="{Binding Rol}" Value="Tecnico">
                                                    <Setter Property="BackgroundColor" Value="#FEF3C7"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border"
                                                         Binding="{Binding Rol}" Value="Consulta">
                                                    <Setter Property="BackgroundColor" Value="#F3F4F6"/>
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Label Text="{Binding Rol}" FontSize="11" FontAttributes="Bold">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label"
                                                             Binding="{Binding Rol}" Value="Administrador">
                                                        <Setter Property="TextColor" Value="#512BD4"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label"
                                                             Binding="{Binding Rol}" Value="OP">
                                                        <Setter Property="TextColor" Value="#1E40AF"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label"
                                                             Binding="{Binding Rol}" Value="Tecnico">
                                                        <Setter Property="TextColor" Value="#92400E"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label"
                                                             Binding="{Binding Rol}" Value="Consulta">
                                                        <Setter Property="TextColor" Value="#6B7280"/>
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>

                                <!-- Sin separador ni estado -->
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </Grid>
        <!-- ═══════════════════════════════════════════ -->
        <!-- OVERLAY + PANEL LATERAL — Nuevo usuario      -->
        <!-- ═══════════════════════════════════════════ -->
        <Grid x:Name="PanelOverlay" IsVisible="False" ColumnDefinitions="*,420">

            <!-- Fondo oscuro semitransparente -->
            <BoxView Grid.Column="0"
                   BackgroundColor="#55000000">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCerrarPanelTapped"/>
                </BoxView.GestureRecognizers>
            </BoxView>

            <!-- Panel blanco lateral -->
            <Border Grid.Column="1"
                  BackgroundColor="White"
                  StrokeThickness="0"
                  StrokeShape="RoundRectangle 24,0,0,24">
                <Border.Shadow>
                    <Shadow Brush="#50000000" Offset="-8,0" Radius="32" Opacity="1"/>
                </Border.Shadow>

                <ScrollView>
                    <VerticalStackLayout Padding="32,32,32,40" Spacing="0">

                        <!-- Encabezado -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="Nuevo usuario"
                                     FontSize="22" FontAttributes="Bold" TextColor="#1A1F3A"/>
                                <Label Text="Completa los datos para crear una cuenta de acceso al sistema."
                                     FontSize="12" TextColor="#9AA3BE"/>
                            </VerticalStackLayout>
                            <Border Grid.Column="1"
                                  BackgroundColor="#F5F3FC"
                                  StrokeShape="RoundRectangle 10"
                                  StrokeThickness="0"
                                  WidthRequest="36" HeightRequest="36"
                                  VerticalOptions="Start">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCerrarPanelTapped"/>
                                </Border.GestureRecognizers>
                                <Label FontFamily="FontAwesome" Text="&#xf00d;"
                                     FontSize="14" TextColor="#9AA3BE"
                                     HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="#F0EDF9" Margin="0,16,0,24"/>

                        <!-- Nombre completo -->
                        <VerticalStackLayout Spacing="6" Margin="0,0,0,16">
                            <Label Text="Nombre completo" FontSize="12" FontAttributes="Bold"
                                 TextColor="#4A5270" CharacterSpacing="0.3"/>
                            <Border BackgroundColor="#F8F7FC" StrokeShape="RoundRectangle 12"
                                  Stroke="#E8E4F8" StrokeThickness="1" Padding="14,0">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Label Grid.Column="0" FontFamily="FontAwesome" Text="&#xf007;"
                                         FontSize="13" TextColor="#C4B5FD" VerticalOptions="Center"/>
                                    <Entry Grid.Column="1" x:Name="NombreEntry"
                                         Placeholder="Ej. Juan Pérez" TextColor="#1A1F3A"
                                         PlaceholderColor="#C4C9D8" HeightRequest="48"
                                         BackgroundColor="Transparent"/>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Nombre de usuario -->
                        <VerticalStackLayout Spacing="6" Margin="0,0,0,16">
                            <Label Text="Nombre de usuario" FontSize="12" FontAttributes="Bold"
                                 TextColor="#4A5270" CharacterSpacing="0.3"/>
                            <Border BackgroundColor="#F8F7FC" StrokeShape="RoundRectangle 12"
                                  Stroke="#E8E4F8" StrokeThickness="1" Padding="14,0">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Label Grid.Column="0" FontFamily="FontAwesome" Text="&#xf406;"
                                         FontSize="13" TextColor="#C4B5FD" VerticalOptions="Center"/>
                                    <Entry Grid.Column="1" x:Name="NicknameEntry"
                                         Placeholder="Ej. jperez" TextColor="#1A1F3A"
                                         PlaceholderColor="#C4C9D8" HeightRequest="48"
                                         BackgroundColor="Transparent"/>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Correo -->
                        <VerticalStackLayout Spacing="6" Margin="0,0,0,16">
                            <Label Text="Correo electrónico" FontSize="12" FontAttributes="Bold"
                                 TextColor="#4A5270" CharacterSpacing="0.3"/>
                            <Border BackgroundColor="#F8F7FC" StrokeShape="RoundRectangle 12"
                                  Stroke="#E8E4F8" StrokeThickness="1" Padding="14,0">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Label Grid.Column="0" FontFamily="FontAwesome" Text="&#xf0e0;"
                                         FontSize="13" TextColor="#C4B5FD" VerticalOptions="Center"/>
                                    <Entry Grid.Column="1" x:Name="CorreoEntry"
                                         Placeholder="Ej. jperez@cpc.com" Keyboard="Email"
                                         TextColor="#1A1F3A" PlaceholderColor="#C4C9D8"
                                         HeightRequest="48" BackgroundColor="Transparent"/>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Teléfono -->
                        <VerticalStackLayout Spacing="6" Margin="0,0,0,16">
                            <Label Text="Teléfono" FontSize="12" FontAttributes="Bold"
                                 TextColor="#4A5270" CharacterSpacing="0.3"/>
                            <Border BackgroundColor="#F8F7FC" StrokeShape="RoundRectangle 12"
                                  Stroke="#E8E4F8" StrokeThickness="1" Padding="14,0">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Label Grid.Column="0" FontFamily="FontAwesome" Text="&#xf095;"
                                         FontSize="13" TextColor="#C4B5FD" VerticalOptions="Center"/>
                                    <Entry Grid.Column="1" x:Name="TelefonoEntry"
                                         Placeholder="Ej. 1234-5678" Keyboard="Telephone"
                                         TextColor="#1A1F3A" PlaceholderColor="#C4C9D8"
                                         HeightRequest="48" BackgroundColor="Transparent"/>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Contraseña -->
                        <VerticalStackLayout Spacing="6" Margin="0,0,0,24">
                            <Label Text="Contraseña" FontSize="12" FontAttributes="Bold"
                                 TextColor="#4A5270" CharacterSpacing="0.3"/>
                            <Border BackgroundColor="#F8F7FC" StrokeShape="RoundRectangle 12"
                                  Stroke="#E8E4F8" StrokeThickness="1" Padding="14,0">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Label Grid.Column="0" FontFamily="FontAwesome" Text="&#xf023;"
                                         FontSize="13" TextColor="#C4B5FD" VerticalOptions="Center"/>
                                    <Entry Grid.Column="1" x:Name="ContrasenaEntry"
                                         Placeholder="••••••••" IsPassword="True"
                                         TextColor="#1A1F3A" PlaceholderColor="#C4C9D8"
                                         HeightRequest="48" BackgroundColor="Transparent"/>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Rol -->
                        <VerticalStackLayout x:Name="SeccionRol" Spacing="10" Margin="0,0,0,28">
                            <Label Text="Rol" FontSize="12" FontAttributes="Bold"
                                 TextColor="#4A5270" CharacterSpacing="0.3"/>
                            <Button x:Name="BtnAdministrador" Clicked="OnRolAdministrador"
                                  Text="Administrador"
                                  BackgroundColor="#F8F7FC" TextColor="#4A5270"
                                  BorderColor="#E8E4F8" BorderWidth="1"
                                  FontSize="13" FontAttributes="Bold"
                                  HeightRequest="50" CornerRadius="12">
                                <Button.ImageSource>
                                    <FontImageSource FontFamily="FontAwesome" Glyph="&#xf505;"
                                                   Color="#C4B5FD" Size="14"/>
                                </Button.ImageSource>
                            </Button>
                            <Button x:Name="BtnTecnico" Clicked="OnRolTecnico"
                                  Text="Técnico / OP"
                                  BackgroundColor="#F8F7FC" TextColor="#4A5270"
                                  BorderColor="#E8E4F8" BorderWidth="1"
                                  FontSize="13" FontAttributes="Bold"
                                  HeightRequest="50" CornerRadius="12">
                                <Button.ImageSource>
                                    <FontImageSource FontFamily="FontAwesome" Glyph="&#xf0ad;"
                                                   Color="#C4B5FD" Size="14"/>
                                </Button.ImageSource>
                            </Button>
                            <Button x:Name="BtnConsulta" Clicked="OnRolConsulta"
                                  Text="Consulta"
                                  BackgroundColor="#F8F7FC" TextColor="#4A5270"
                                  BorderColor="#E8E4F8" BorderWidth="1"
                                  FontSize="13" FontAttributes="Bold"
                                  HeightRequest="50" CornerRadius="12">
                                <Button.ImageSource>
                                    <FontImageSource FontFamily="FontAwesome" Glyph="&#xf007;"
                                                   Color="#C4B5FD" Size="14"/>
                                </Button.ImageSource>
                            </Button>
                        </VerticalStackLayout>

                        <!-- Switch oculto — siempre activo para la lógica -->
                        <Switch x:Name="ActivoSwitch" IsToggled="True" IsVisible="False"/>

                        <!-- Botón registrar -->
                        <Button Text="Registrar usuario"
                              Clicked="OnRegistrarClicked"
                              BackgroundColor="#512BD4" TextColor="White"
                              FontAttributes="Bold" FontSize="14"
                              HeightRequest="52" CornerRadius="14"
                              Margin="0,0,0,10">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="FontAwesome" Glyph="&#xf234;"
                                               Color="White" Size="15"/>
                            </Button.ImageSource>
                            <Button.Shadow>
                                <Shadow Brush="#40512BD4" Offset="0,4" Radius="14" Opacity="1"/>
                            </Button.Shadow>
                        </Button>

                        <!-- Botón cancelar -->
                        <Button Text="Cancelar"
                              Clicked="OnCerrarPanelTapped"
                              BackgroundColor="Transparent" TextColor="#9AA3BE"
                              FontSize="13" HeightRequest="44" CornerRadius="12"
                              BorderColor="#E8E4F8" BorderWidth="1"/>

                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
