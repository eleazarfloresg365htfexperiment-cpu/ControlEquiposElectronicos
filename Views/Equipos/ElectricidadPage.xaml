<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ControlEquiposElectronicos.Views.Equipos.ElectricidadPage"
    Title="Electricidad">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Modulo Electricidad"
                   FontSize="30"
                   FontAttributes="Bold"/>

            <Button Text="Registrar UPS"
                    Clicked="OnRegistrarUPS"/>

            <Button Text="Registrar Bateria"
                    Clicked="OnRegistrarBateria"/>

            <Button Text="Registrar Aire Acondicionado"
                    Clicked="OnRegistrarAire"/>

            <Button Text="Registrar BTU"
                    Clicked="OnRegistrarBTU"/>

            <Button Text="Ver Servicios"
                    Clicked="OnVerServicios"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>