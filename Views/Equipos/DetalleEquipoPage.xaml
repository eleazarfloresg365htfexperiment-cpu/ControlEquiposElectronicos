<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ControlEquiposElectronicos.Views.Equipos.DetalleEquipoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:helpers="clr-namespace:ControlEquiposElectronicos.Helpers"
    Title="Detalle del Equipo"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F8F9FB">

    <ContentPage.Resources>
        <helpers:BoolToSiNoConverter x:Key="BoolToSiNo"/>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Grid ColumnDefinitions="Auto,*">
                <Button Grid.Column="0" Text="← Volver"
                        BackgroundColor="#F0F2F7" TextColor="#5A6282"
                        CornerRadius="8" FontSize="12" Padding="12,7"
                        x:Name="BtnVolver"/>
                <VerticalStackLayout Grid.Column="1" Spacing="2" Margin="12,0,0,0">
                    <Label Text="Detalle del equipo" FontSize="22" FontAttributes="Bold" TextColor="#1A1F3A"/>
                    <Label Text="{Binding Equipo.Codigo}" FontSize="13" TextColor="#9AA3BE"/>
                </VerticalStackLayout>
            </Grid>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">

                <VerticalStackLayout Grid.Column="0" Spacing="14">

                    <Border BackgroundColor="White" Stroke="#E2E6F0" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="18">
                        <VerticalStackLayout Spacing="0">
                            <HorizontalStackLayout Spacing="8" Margin="0,0,0,12">
                                <Label FontFamily="FontAwesome" Text="&#xf108;" FontSize="13" TextColor="#378ADD" VerticalOptions="Center"/>
                                <Label Text="Información general" FontSize="13" FontAttributes="Bold" TextColor="#1E2A6E"/>
                            </HorizontalStackLayout>

                            <Grid ColumnDefinitions="*,*" Padding="0,8">
                                <Label Grid.Column="0" Text="Código" FontSize="12" TextColor="#9AA3BE"/>
                                <Label Grid.Column="1" Text="{Binding Equipo.Codigo}" FontSize="12" FontAttributes="Bold" HorizontalOptions="End"/>
                            </Grid>
                            <BoxView HeightRequest="1" BackgroundColor="#F0F2F7"/>

                            <Grid ColumnDefinitions="*,*" Padding="0,8">
                                <Label Grid.Column="0" Text="Nombre" FontSize="12" TextColor="#9AA3BE"/>
                                <Label Grid.Column="1" Text="{Binding Equipo.Nombre}" FontSize="12" FontAttributes="Bold" HorizontalOptions="End"/>
                            </Grid>
                            <BoxView HeightRequest="1" BackgroundColor="#F0F2F7"/>

                            <Grid ColumnDefinitions="*,*" Padding="0,8">
                                <Label Grid.Column="0" Text="Categoría" FontSize="12" TextColor="#9AA3BE"/>
                                <Label Grid.Column="1" Text="{Binding Equipo.Categoria}" FontSize="12" FontAttributes="Bold" HorizontalOptions="End"/>
                            </Grid>
                            <BoxView HeightRequest="1" BackgroundColor="#F0F2F7"/>

                            <Grid ColumnDefinitions="*,*" Padding="0,8">
                                <Label Grid.Column="0" Text="Tipo" FontSize="12" TextColor="#9AA3BE"/>
                                <Label Grid.Column="1" Text="{Binding Equipo.Tipo}" FontSize="12" FontAttributes="Bold" HorizontalOptions="End"/>
                            </Grid>
                            <BoxView HeightRequest="1" BackgroundColor="#F0F2F7"/>

                            <Grid ColumnDefinitions="*,*" Padding="0,8">
                                <Label Grid.Column="0" Text="Marca" FontSize="12" TextColor="#9AA3BE"/>
                                <Label Grid.Column="1" Text="{Binding Equipo.Marca}" FontSize="12" FontAttributes="Bold" HorizontalOptions="End"/>
                            </Grid>
                            <BoxView HeightRequest="1" BackgroundColor="#F0F2F7"/>

                            <Grid ColumnDefinitions="*,*" Padding="0,8">
                                <Label Grid.Column="0" Text="Modelo" FontSize="12" TextColor="#9AA3BE"/>
                                <Label Grid.Column="1" Text="{Binding Equipo.Modelo}" FontSize="12" FontAttributes="Bold" HorizontalOptions="End"/>
                            </Grid>
                            <BoxView HeightRequest="1" BackgroundColor="#F0F2F7"/>

                            <Grid ColumnDefinitions="*,*" Padding="0,8">
                                <Label Grid.Column="0" Text="No. serie" FontSize="12" TextColor="#9AA3BE"/>
                                <Label Grid.Column="1" Text="{Binding Equipo.NumeroSerie}" FontSize="12" FontAttributes="Bold" HorizontalOptions="End"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Border BackgroundColor="White" Stroke="#E2E6F0" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="18">
                        <VerticalStackLayout Spacing="0">
                            <HorizontalStackLayout Spacing="8" Margin="0,0,0,12">
                                <Label FontFamily="FontAwesome" Text="&#xf3c5;" FontSize="13" TextColor="#E24B4A" VerticalOptions="Center"/>
                                <Label Text="Ubicación y estado" FontSize="13" FontAttributes="Bold" TextColor="#1E2A6E"/>
                            </HorizontalStackLayout>

                            <Grid ColumnDefinitions="*,*" Padding="0,8">
                                <Label Grid.Column="0" Text="Ubicación" FontSize="12" TextColor="#9AA3BE"/>
                                <Label Grid.Column="1" Text="{Binding Equipo.Ubicacion}" FontSize="12" FontAttributes="Bold" HorizontalOptions="End"/>
                            </Grid>
                            <BoxView HeightRequest="1" BackgroundColor="#F0F2F7"/>

                            <Grid ColumnDefinitions="*,*" Padding="0,8">
                                <Label Grid.Column="0" Text="Estado" FontSize="12" TextColor="#9AA3BE"/>
                                <Label Grid.Column="1" Text="{Binding Equipo.Estado}" FontSize="12" FontAttributes="Bold" HorizontalOptions="End"/>
                            </Grid>
                            <BoxView HeightRequest="1" BackgroundColor="#F0F2F7"/>

                            <Grid ColumnDefinitions="*,*" Padding="0,8">
                                <Label Grid.Column="0" Text="Activo" FontSize="12" TextColor="#9AA3BE"/>
                                <Label Grid.Column="1" Text="{Binding Equipo.Activo, Converter={StaticResource BoolToSiNo}}" FontSize="12" FontAttributes="Bold" HorizontalOptions="End"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="10" WidthRequest="200">
                    <Border BackgroundColor="White" Stroke="#E2E6F0" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="16">
                        <VerticalStackLayout Spacing="8">
                            <HorizontalStackLayout Spacing="8" Margin="0,0,0,4">
                                <Label FontFamily="FontAwesome" Text="&#xf0ad;" FontSize="13" TextColor="#1E2A6E" VerticalOptions="Center"/>
                                <Label Text="Acciones" FontSize="13" FontAttributes="Bold" TextColor="#1E2A6E"/>
                            </HorizontalStackLayout>

                            <Button Text="✏ Editar información"
                                    BackgroundColor="#DBEAFE" TextColor="#1E40AF"
                                    CornerRadius="9" FontSize="12" Padding="10"
                                    x:Name="BtnEditar"/>

                            <Button Text="🔄 Cambiar estado"
                                    BackgroundColor="#FEF3C7" TextColor="#92400E"
                                    CornerRadius="9" FontSize="12" Padding="10"
                                    x:Name="BtnCambiarEstado"/>

                            <Button Text="🏷️ Reclasificar"
                                    BackgroundColor="#EDE9FE" TextColor="#5B21B6"
                                    CornerRadius="9" FontSize="12" Padding="10"
                                    x:Name="BtnReclasificar"/>

                            <Button Text="🗑️ Desactivar"
                                    BackgroundColor="#FEE2E2" TextColor="#991B1B"
                                    CornerRadius="9" FontSize="12" Padding="10"
                                    x:Name="BtnDesactivar"/>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>