<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ControlEquiposElectronicos.Views.Equipos.RedPage"
    Title="Red">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Modulo Red"
                   FontSize="30"
                   FontAttributes="Bold"/>

            <Button Text="Registrar Router"
                    Clicked="OnRegistrarRouter"/>

            <Button Text="Registrar Switch"
                    Clicked="OnRegistrarSwitch"/>

            <Button Text="Registrar Puerto"
                    Clicked="OnRegistrarPuerto"/>

            <Button Text="Ver Historial"
                    Clicked="OnVerHistorial"/>

            <Button Text="Reportar Falla"
                    Clicked="OnReportarFalla"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
    