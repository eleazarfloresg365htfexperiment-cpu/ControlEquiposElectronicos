<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ControlEquiposElectronicos.ViewModels.Equipos"
             x:Class="ControlEquiposElectronicos.Views.Equipos.RedPage"
             Title="Infraestructura de Red"
             BackgroundColor="#F4F6F9">

    <ContentPage.BindingContext>
        <vm:RedViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto,*">

        <!-- Header azul claro con texto blanco legible -->
        <Border Grid.Row="0" BackgroundColor="#1976D2" Padding="20,16" StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0"/>
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout>
                    <Label Text="🌐 Infraestructura de Red"
                           FontSize="20" FontAttributes="Bold" TextColor="White"/>
                    <Label Text="Routers · Switches · Repetidores"
                           FontSize="12" TextColor="#BBDEFB"/>
                </VerticalStackLayout>
                <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                    <Button Text="+ Router"
                            Command="{Binding RegistrarRouterCommand}"
                            BackgroundColor="White" TextColor="#1976D2"
                            FontSize="13" CornerRadius="8" FontAttributes="Bold"/>
                    <Button Text="+ Switch"
                            Command="{Binding RegistrarSwitchCommand}"
                            BackgroundColor="White" TextColor="#1976D2"
                            FontSize="13" CornerRadius="8" FontAttributes="Bold"/>
                    <Button Text="+ Repetidor"
                            Command="{Binding RegistrarRepetidorCommand}"
                            BackgroundColor="White" TextColor="#1976D2"
                            FontSize="13" CornerRadius="8" FontAttributes="Bold"/>
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="16">

                <!-- Buscador -->
                <Border BackgroundColor="White" Padding="12" StrokeThickness="1" Stroke="#E0E0E0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry Placeholder="Buscar por código, ubicación o tipo..."
                               Text="{Binding BusquedaTexto}"
                               TextColor="#212121"
                               PlaceholderColor="#9E9E9E"
                               BackgroundColor="Transparent"/>
                        <Button Grid.Column="1" Text="Buscar"
                                Command="{Binding BuscarCommand}"
                                BackgroundColor="#1976D2" TextColor="White" CornerRadius="8"/>
                    </Grid>
                </Border>

                <!-- Tarjetas resumen -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                    <Border BackgroundColor="White" Padding="16"
                            StrokeThickness="1" Stroke="#E0E0E0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout>
                            <Label Text="🔀 Routers" FontSize="13" TextColor="#757575"/>
                            <Label Text="{Binding TotalRouters}" FontSize="28"
                                   FontAttributes="Bold" TextColor="#1976D2"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" BackgroundColor="White" Padding="16"
                            StrokeThickness="1" Stroke="#E0E0E0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout>
                            <Label Text="🔌 Switches" FontSize="13" TextColor="#757575"/>
                            <Label Text="{Binding TotalSwitches}" FontSize="28"
                                   FontAttributes="Bold" TextColor="#1976D2"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" BackgroundColor="White" Padding="16"
                            StrokeThickness="1" Stroke="#E0E0E0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout>
                            <Label Text="📡 Repetidores" FontSize="13" TextColor="#757575"/>
                            <Label Text="{Binding TotalRepetidores}" FontSize="28"
                                   FontAttributes="Bold" TextColor="#1976D2"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Indicador de carga -->
                <ActivityIndicator IsRunning="{Binding Cargando}"
                                   IsVisible="{Binding Cargando}"
                                   Color="#1976D2" HorizontalOptions="Center"/>

                <Label Text="Dispositivos registrados" FontSize="16"
                       FontAttributes="Bold" TextColor="#212121"/>

                <!-- Lista -->
                <CollectionView ItemsSource="{Binding Dispositivos}"
                                EmptyView="No hay dispositivos registrados.">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10" BackgroundColor="White"
                                    Padding="16" StrokeThickness="1" Stroke="#E0E0E0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border WidthRequest="46" HeightRequest="46"
                                            BackgroundColor="#E3F2FD"
                                            Padding="0" StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="23"/>
                                        </Border.StrokeShape>
                                        <Label Text="🌐" FontSize="20"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Margin="12,0"
                                                         VerticalOptions="Center">
                                        <Label Text="{Binding Nombre}" FontSize="15"
                                               FontAttributes="Bold" TextColor="#212121"/>
                                        <Label Text="{Binding Codigo}" FontSize="12"
                                               TextColor="#9E9E9E"/>
                                        <Label Text="{Binding Ubicacion}" FontSize="12"
                                               TextColor="#1976D2"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" Spacing="6">
                                        <Button Text="Ver"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.VerDetalleCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#E3F2FD" TextColor="#1976D2"
                                                FontSize="12" CornerRadius="6" Padding="8,4"/>
                                        <Button Text="Puertos"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.VerPuertosCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#FFF8E1" TextColor="#F57F17"
                                                FontSize="12" CornerRadius="6" Padding="8,4"/>
                                        <Button Text="Falla"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ReportarFallaCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#FFEBEE" TextColor="#C62828"
                                                FontSize="12" CornerRadius="6" Padding="8,4"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Button Text="↻ Actualizar lista"
                        Command="{Binding ActualizarCommand}"
                        BackgroundColor="#E3F2FD" TextColor="#1976D2"
                        CornerRadius="10" FontSize="13" Margin="0,0,0,20"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
    