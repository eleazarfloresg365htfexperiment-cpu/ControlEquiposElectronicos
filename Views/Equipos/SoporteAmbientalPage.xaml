<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ControlEquiposElectronicos.ViewModels.Equipos"
             x:Class="ControlEquiposElectronicos.Views.Equipos.SoporteAmbientalPage"
             Title="Soporte Ambiental" BackgroundColor="#F4F6F9">

    <ContentPage.BindingContext>
        <vm:SoporteAmbientalViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" BackgroundColor="#2E7D32" Padding="20,16" StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0"/>
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout>
                    <Label Text="🌿 Soporte Ambiental" FontSize="20"
                           FontAttributes="Bold" TextColor="White"/>
                    <Label Text="Aire acondicionado · Ambientadores · Mantenimiento"
                           FontSize="12" TextColor="#C8E6C9"/>
                </VerticalStackLayout>
                <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                    <Button Text="+ Aire" Command="{Binding RegistrarAireCommand}"
                            BackgroundColor="White" TextColor="#2E7D32"
                            FontSize="13" CornerRadius="8" FontAttributes="Bold"/>
                    <Button Text="+ Ambientador" Command="{Binding RegistrarAmbientadorCommand}"
                            BackgroundColor="White" TextColor="#2E7D32"
                            FontSize="13" CornerRadius="8" FontAttributes="Bold"/>
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="16">

                <Border BackgroundColor="White" Padding="12"
                        StrokeThickness="1" Stroke="#E0E0E0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry Placeholder="Buscar por código o ubicación..."
                               Text="{Binding BusquedaTexto}"
                               TextColor="#212121" PlaceholderColor="#9E9E9E"
                               BackgroundColor="Transparent"/>
                        <Button Grid.Column="1" Text="Buscar"
                                Command="{Binding BuscarCommand}"
                                BackgroundColor="#2E7D32" TextColor="White" CornerRadius="8"/>
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border BackgroundColor="White" Padding="16"
                            StrokeThickness="1" Stroke="#E0E0E0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout>
                            <Label Text="❄️ Aires acondicionados" FontSize="13" TextColor="#757575"/>
                            <Label Text="{Binding TotalAires}" FontSize="28"
                                   FontAttributes="Bold" TextColor="#2E7D32"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" BackgroundColor="White" Padding="16"
                            StrokeThickness="1" Stroke="#E0E0E0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout>
                            <Label Text="🌸 Ambientadores" FontSize="13" TextColor="#757575"/>
                            <Label Text="{Binding TotalAmbientadores}" FontSize="28"
                                   FontAttributes="Bold" TextColor="#2E7D32"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <ActivityIndicator IsRunning="{Binding Cargando}"
                                   IsVisible="{Binding Cargando}"
                                   Color="#2E7D32" HorizontalOptions="Center"/>

                <Label Text="Equipos ambientales" FontSize="16"
                       FontAttributes="Bold" TextColor="#212121"/>

                <CollectionView ItemsSource="{Binding EquiposAmbientales}"
                                EmptyView="No hay equipos ambientales registrados.">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10" BackgroundColor="White"
                                    Padding="16" StrokeThickness="1" Stroke="#E0E0E0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border WidthRequest="46" HeightRequest="46"
                                            BackgroundColor="#E8F5E9" Padding="0" StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="23"/>
                                        </Border.StrokeShape>
                                        <Label Text="🌿" FontSize="20"
                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Margin="12,0" VerticalOptions="Center">
                                        <Label Text="{Binding Nombre}" FontSize="15"
                                               FontAttributes="Bold" TextColor="#212121"/>
                                        <Label Text="{Binding Codigo}" FontSize="12" TextColor="#9E9E9E"/>
                                        <Label Text="{Binding Ubicacion}" FontSize="12" TextColor="#2E7D32"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" Spacing="6">
                                        <Button Text="Detalle"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RegistrarMantenimientoCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#E8F5E9" TextColor="#2E7D32"
                                                FontSize="12" CornerRadius="6" Padding="8,4"/>
                                        <Button Text="Reportar"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ReportarProblemaCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#FFEBEE" TextColor="#C62828"
                                                FontSize="12" CornerRadius="6" Padding="8,4"/>
                                        <Button Text="Recarga"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RegistrarRecargaCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#FFF8E1" TextColor="#F57F17"
                                                FontSize="12" CornerRadius="6" Padding="8,4"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Button Text="↻ Actualizar lista" Command="{Binding ActualizarCommand}"
                        BackgroundColor="#E8F5E9" TextColor="#2E7D32"
                        CornerRadius="10" FontSize="13" Margin="0,0,0,20"/>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
    
