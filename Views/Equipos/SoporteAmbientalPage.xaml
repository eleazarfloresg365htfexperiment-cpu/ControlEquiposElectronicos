<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ControlEquiposElectronicos.Views.Equipos.SoporteAmbientalPage"
    Title="Soporte ambiental">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Modulo Soporte Ambiental"
                   FontSize="30"
                   FontAttributes="Bold"/>

            <Button Text="Registrar Ambientador"
                    Clicked="OnRegistrarAmbientador"/>

            <Button Text="Registrar Soporte"
                    Clicked="OnRegistrarSoporte"/>

            <Button Text="Editar Detalle"
                    Clicked="OnEditarDetalle"/>

            <Button Text="Reportar Problema"
                    Clicked="OnReportarProblema"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>