<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ControlEquiposElectronicos.Views.Equipos.ImpresionPage"
    Title="Impresión">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Modulo Impresión"
                   FontSize="30"
                   FontAttributes="Bold"/>

            <Button Text="Registrar Impresora"
                    Clicked="OnRegistrarImpresora"/>

            <Button Text="Registrar Cartucho"
                    Clicked="OnRegistrarCartucho"/>

            <Button Text="Editar Detalle"
                    Clicked="OnEditarDetalle"/>

            <Button Text="Ver Historial"
                    Clicked="OnVerHistorial"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>