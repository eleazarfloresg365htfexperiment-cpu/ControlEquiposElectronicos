<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ControlEquiposElectronicos.Views.Mantenimientos.MantenimientoFormularioPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Formulario de mantenimiento"
    BackgroundColor="#F5F5F5">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20">

            <VerticalStackLayout Spacing="4">
                <Label Text="Registrar mantenimiento" FontSize="28" FontAttributes="Bold" TextColor="#1A1A2E" />
                <Label Text="Completa los datos del mantenimiento técnico" FontSize="14" TextColor="#666666" />
            </VerticalStackLayout>

            <Border BackgroundColor="White" StrokeShape="RoundRectangle 12" Stroke="#E0E0E0" Padding="24">
                <VerticalStackLayout Spacing="18">

                    <!-- ID de equipo -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="ID del equipo" FontAttributes="Bold" FontSize="13" TextColor="#1A1A2E" />
                        <Border StrokeShape="RoundRectangle 8" Stroke="#E0E0E0" BackgroundColor="#FAFAFA" Padding="12,10">
                            <Entry Placeholder="Ej: 1"
                                   PlaceholderColor="#AAAAAA"
                                   TextColor="#1A1A2E"
                                   FontSize="14"
                                   Keyboard="Numeric"
                                   BackgroundColor="Transparent"
                                   Text="{Binding EquipoIdTexto}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Descripción -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Descripción del trabajo" FontAttributes="Bold" FontSize="13" TextColor="#1A1A2E" />
                        <Border StrokeShape="RoundRectangle 8" Stroke="#E0E0E0" BackgroundColor="#FAFAFA" Padding="12,10">
                            <Editor Placeholder="Describe el mantenimiento realizado..."
                                    PlaceholderColor="#AAAAAA"
                                    TextColor="#1A1A2E"
                                    FontSize="14"
                                    HeightRequest="100"
                                    BackgroundColor="Transparent"
                                    Text="{Binding Descripcion}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Diagnóstico -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Diagnóstico (opcional)" FontAttributes="Bold" FontSize="13" TextColor="#1A1A2E" />
                        <Border StrokeShape="RoundRectangle 8" Stroke="#E0E0E0" BackgroundColor="#FAFAFA" Padding="12,10">
                            <Editor Placeholder="Diagnóstico técnico..."
                                    PlaceholderColor="#AAAAAA"
                                    TextColor="#1A1A2E"
                                    FontSize="14"
                                    HeightRequest="80"
                                    BackgroundColor="Transparent"
                                    Text="{Binding Diagnostico}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Costo estimado -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Costo estimado (opcional)" FontAttributes="Bold" FontSize="13" TextColor="#1A1A2E" />
                        <Border StrokeShape="RoundRectangle 8" Stroke="#E0E0E0" BackgroundColor="#FAFAFA" Padding="12,10">
                            <Entry Placeholder="Ej: 150.00"
                                   PlaceholderColor="#AAAAAA"
                                   TextColor="#1A1A2E"
                                   FontSize="14"
                                   Keyboard="Numeric"
                                   BackgroundColor="Transparent"
                                   Text="{Binding CostoEstimado}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Estado -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Estado" FontAttributes="Bold" FontSize="13" TextColor="#1A1A2E" />
                        <Border StrokeShape="RoundRectangle 8" Stroke="#E0E0E0" BackgroundColor="#FAFAFA" Padding="12,4">
                            <Picker Title="Seleccionar estado..."
                                    TitleColor="#AAAAAA"
                                    TextColor="#1A1A2E"
                                    FontSize="14"
                                    BackgroundColor="Transparent"
                                    SelectedItem="{Binding EstadoMantenimiento}">
                                <Picker.Items>
                                    <x:String>Pendiente</x:String>
                                    <x:String>En proceso</x:String>
                                    <x:String>Completado</x:String>
                                </Picker.Items>
                            </Picker>
                        </Border>
                    </VerticalStackLayout>

                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#4F8EF7" HorizontalOptions="Center" />

                    <!-- BOTONES -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,0">
                        <Border Grid.Column="0" StrokeShape="RoundRectangle 8" Stroke="#CCCCCC" BackgroundColor="White" Padding="0">
                            <Button Text="Cancelar"
                                    BackgroundColor="White"
                                    TextColor="#666666"
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    Command="{Binding CancelarCommand}" />
                        </Border>
                        <Border Grid.Column="1" StrokeShape="RoundRectangle 8" Stroke="Transparent" BackgroundColor="#4F8EF7" Padding="0">
                            <Button Text="Guardar registro"
                                    BackgroundColor="#4F8EF7"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    Command="{Binding GuardarCommand}" />
                        </Border>
                    </Grid>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage> git add -A
