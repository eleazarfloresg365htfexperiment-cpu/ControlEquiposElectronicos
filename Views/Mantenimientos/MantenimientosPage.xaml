<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ControlEquiposElectronicos.Views.Mantenimientos.MantenimientosPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Mantenimientos"
    BackgroundColor="#F5F5F5">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20">

            <VerticalStackLayout Spacing="4">
                <Label Text="Mantenimientos" FontSize="28" FontAttributes="Bold" TextColor="#1A1A2E" />
                <Label Text="Gestiona el historial técnico de equipos de la academia" FontSize="14" TextColor="#666666" />
            </VerticalStackLayout>

            <!-- TARJETAS DE ACCIÓN -->
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">

                <Border Grid.Column="0" BackgroundColor="White" StrokeShape="RoundRectangle 12" Stroke="#E0E0E0" Padding="16">
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Border BackgroundColor="#4F8EF7" StrokeShape="RoundRectangle 12" Stroke="Transparent" HeightRequest="56" WidthRequest="56" HorizontalOptions="Center">
                            <Label Text="+" FontSize="28" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="Registrar mantenimiento" FontAttributes="Bold" FontSize="13" TextColor="#1A1A2E" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                        <Label Text="Agregar nuevo registro técnico" FontSize="11" TextColor="#888888" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                        <Button Text="Abrir" BackgroundColor="#4F8EF7" TextColor="White" FontSize="12" CornerRadius="8" Command="{Binding RegistrarNuevoCommand}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" BackgroundColor="White" StrokeShape="RoundRectangle 12" Stroke="#E0E0E0" Padding="16">
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Border BackgroundColor="#2ECB8A" StrokeShape="RoundRectangle 12" Stroke="Transparent" HeightRequest="56" WidthRequest="56" HorizontalOptions="Center">
                            <Label Text="✏️" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="Editar registro" FontAttributes="Bold" FontSize="13" TextColor="#1A1A2E" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                        <Label Text="Selecciona un registro de la tabla" FontSize="11" TextColor="#888888" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="2" BackgroundColor="White" StrokeShape="RoundRectangle 12" Stroke="#E0E0E0" Padding="16">
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Border BackgroundColor="#A855F7" StrokeShape="RoundRectangle 12" Stroke="Transparent" HeightRequest="56" WidthRequest="56" HorizontalOptions="Center">
                            <Label Text="✔️" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="Finalizar mantenimiento" FontAttributes="Bold" FontSize="13" TextColor="#1A1A2E" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                        <Label Text="Selecciona un registro de la tabla" FontSize="11" TextColor="#888888" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="3" BackgroundColor="White" StrokeShape="RoundRectangle 12" Stroke="#E0E0E0" Padding="16">
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Border BackgroundColor="#F5A623" StrokeShape="RoundRectangle 12" Stroke="Transparent" HeightRequest="56" WidthRequest="56" HorizontalOptions="Center">
                            <Label Text="🕐" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="Historial técnico" FontAttributes="Bold" FontSize="13" TextColor="#1A1A2E" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                        <Label Text="Ver historial de cambios" FontSize="11" TextColor="#888888" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                        <Button Text="Ver" BackgroundColor="#F5A623" TextColor="White" FontSize="12" CornerRadius="8" Command="{Binding HistorialCommand}" />
                    </VerticalStackLayout>
                </Border>

            </Grid>

            <!-- TABLA -->
            <Border BackgroundColor="White" StrokeShape="RoundRectangle 12" Stroke="#E0E0E0" Padding="20">
                <VerticalStackLayout Spacing="16">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Listado de mantenimientos" FontSize="18" FontAttributes="Bold" TextColor="#1A1A2E" VerticalOptions="Center" />
                        <Border Grid.Column="1" BackgroundColor="#4F8EF7" StrokeShape="RoundRectangle 8" Stroke="Transparent" Padding="0">
                            <Button Text="+ Registrar nuevo"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    BackgroundColor="#4F8EF7"
                                    Command="{Binding RegistrarNuevoCommand}"
                                    Padding="14,10"/>
                        </Border>
                    </Grid>

                    <Border StrokeShape="RoundRectangle 8" Stroke="#E0E0E0" BackgroundColor="#FAFAFA" Padding="12,8">
                        <Entry Placeholder="🔍  Buscar mantenimiento..."
                               PlaceholderColor="#AAAAAA"
                               FontSize="13"
                               BackgroundColor="Transparent"
                               Text="{Binding Busqueda}" />
                    </Border>

                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#4F8EF7" HorizontalOptions="Center" />

                    <Grid ColumnDefinitions="50,110,120,110,120,80,120" BackgroundColor="#F0F0F0" Padding="10,8">
                        <Label Grid.Column="0" Text="ID" FontAttributes="Bold" FontSize="13" TextColor="#555" />
                        <Label Grid.Column="1" Text="Código" FontAttributes="Bold" FontSize="13" TextColor="#555" />
                        <Label Grid.Column="2" Text="Equipo" FontAttributes="Bold" FontSize="13" TextColor="#555" />
                        <Label Grid.Column="3" Text="Tipo" FontAttributes="Bold" FontSize="13" TextColor="#555" />
                        <Label Grid.Column="4" Text="Estado" FontAttributes="Bold" FontSize="13" TextColor="#555" />
                        <Label Grid.Column="5" Text="Fecha" FontAttributes="Bold" FontSize="13" TextColor="#555" />
                        <Label Grid.Column="6" Text="Acciones" FontAttributes="Bold" FontSize="13" TextColor="#555" />
                    </Grid>

                    <CollectionView ItemsSource="{Binding Mantenimientos}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="50,110,120,110,120,80,120" Padding="10,10">
                                    <Label Grid.Column="0" Text="{Binding Id}" FontSize="13" TextColor="#333" VerticalOptions="Center"/>
                                    <Label Grid.Column="1" Text="{Binding CodigoEquipo}" FontSize="13" TextColor="#333" VerticalOptions="Center"/>
                                    <Label Grid.Column="2" Text="{Binding NombreEquipo}" FontSize="13" TextColor="#333" VerticalOptions="Center"/>
                                    <Label Grid.Column="3" Text="{Binding TipoMantenimiento}" FontSize="13" TextColor="#333" VerticalOptions="Center"/>
                                    <Border Grid.Column="4"
                                            BackgroundColor="#FFF3CD"
                                            StrokeShape="RoundRectangle 20"
                                            Stroke="Transparent"
                                            Padding="10,4"
                                            HorizontalOptions="Start"
                                            VerticalOptions="Center">
                                        <Label Text="{Binding EstadoMantenimiento}" TextColor="#856404" FontSize="12" FontAttributes="Bold"/>
                                    </Border>
                                    <Label Grid.Column="5" Text="{Binding FechaInicio, StringFormat='{0:dd/MM/yy}'}" FontSize="12" TextColor="#333" VerticalOptions="Center"/>
                                    <HorizontalStackLayout Grid.Column="6" Spacing="4" VerticalOptions="Center">
                                        <Button Text="✏️"
                                                FontSize="14"
                                                BackgroundColor="Transparent"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditarCommand}"
                                                CommandParameter="{Binding .}" />
                                        <Button Text="✔️"
                                                FontSize="14"
                                                BackgroundColor="Transparent"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.FinalizarCommand}"
                                                CommandParameter="{Binding .}" />
                                        <Button Text="🗑️"
                                                FontSize="14"
                                                BackgroundColor="Transparent"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EliminarCommand}"
                                                CommandParameter="{Binding .}" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>