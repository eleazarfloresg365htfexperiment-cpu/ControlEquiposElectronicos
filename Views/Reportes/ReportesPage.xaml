<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ControlEquiposElectronicos.Views.Reportes.ReportesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Reportes"
    BackgroundColor="#F5F5F5">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20">

            <!-- ENCABEZADO -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Reportes"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="#1A1A2E" />
                <Label Text="Consulta y exporta reportes técnicos de la academia"
                       FontSize="14"
                       TextColor="#666666" />
            </VerticalStackLayout>

            <!-- TARJETAS DE ACCIÓN -->
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">

                <!-- Nuevo reporte de falla -->
                <Border Grid.Column="0"
                        BackgroundColor="White"
                        StrokeShape="RoundRectangle 12"
                        Stroke="#E0E0E0"
                        Padding="16">
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Border BackgroundColor="#E53935"
                                StrokeShape="RoundRectangle 12"
                                Stroke="Transparent"
                                HeightRequest="56" WidthRequest="56"
                                HorizontalOptions="Center">
                            <Label Text="⚠️"
                                   FontSize="24"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                        <Label Text="Nuevo reporte de falla"
                               FontAttributes="Bold"
                               FontSize="13"
                               TextColor="#1A1A2E"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Registrar falla técnica"
                               FontSize="11"
                               TextColor="#888888"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Exportar Excel -->
                <Border Grid.Column="1"
                        BackgroundColor="White"
                        StrokeShape="RoundRectangle 12"
                        Stroke="#E0E0E0"
                        Padding="16">
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Border BackgroundColor="#2ECB8A"
                                StrokeShape="RoundRectangle 12"
                                Stroke="Transparent"
                                HeightRequest="56" WidthRequest="56"
                                HorizontalOptions="Center">
                            <Label Text="📊"
                                   FontSize="24"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                        <Label Text="Exportar Excel"
                               FontAttributes="Bold"
                               FontSize="13"
                               TextColor="#1A1A2E"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Descargar reporte .xlsx"
                               FontSize="11"
                               TextColor="#888888"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Exportar PDF -->
                <Border Grid.Column="2"
                        BackgroundColor="White"
                        StrokeShape="RoundRectangle 12"
                        Stroke="#E0E0E0"
                        Padding="16">
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Border BackgroundColor="#A855F7"
                                StrokeShape="RoundRectangle 12"
                                Stroke="Transparent"
                                HeightRequest="56" WidthRequest="56"
                                HorizontalOptions="Center">
                            <Label Text="📄"
                                   FontSize="24"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                        <Label Text="Exportar PDF"
                               FontAttributes="Bold"
                               FontSize="13"
                               TextColor="#1A1A2E"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Descargar reporte .pdf"
                               FontSize="11"
                               TextColor="#888888"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Historial técnico -->
                <Border Grid.Column="3"
                        BackgroundColor="White"
                        StrokeShape="RoundRectangle 12"
                        Stroke="#E0E0E0"
                        Padding="16">
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Border BackgroundColor="#F5A623"
                                StrokeShape="RoundRectangle 12"
                                Stroke="Transparent"
                                HeightRequest="56" WidthRequest="56"
                                HorizontalOptions="Center">
                            <Label Text="🕐"
                                   FontSize="24"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                        <Label Text="Historial técnico"
                               FontAttributes="Bold"
                               FontSize="13"
                               TextColor="#1A1A2E"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Ver auditoría de cambios"
                               FontSize="11"
                               TextColor="#888888"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

            </Grid>

            <!-- TABLA DE REPORTES DE FALLA -->
            <Border BackgroundColor="White"
                    StrokeShape="RoundRectangle 12"
                    Stroke="#E0E0E0"
                    Padding="20">
                <VerticalStackLayout Spacing="16">

                    <!-- Título y botón -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="Reportes de falla"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#1A1A2E"
                               VerticalOptions="Center" />
                        <Border Grid.Column="1"
                                BackgroundColor="#E53935"
                                StrokeShape="RoundRectangle 8"
                                Stroke="Transparent"
                                Padding="14,10">
                            <Label Text="+ Nuevo reporte"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                   FontSize="13" />
                        </Border>
                    </Grid>

                    <!-- Filtros -->
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <Border Grid.Column="0"
                                StrokeShape="RoundRectangle 8"
                                Stroke="#E0E0E0"
                                BackgroundColor="#FAFAFA"
                                Padding="12,8">
                            <Entry Placeholder="🔍  Buscar por código..."
                                   PlaceholderColor="#AAAAAA"
                                   FontSize="13"
                                   BackgroundColor="Transparent" />
                        </Border>
                        <Border Grid.Column="1"
                                StrokeShape="RoundRectangle 8"
                                Stroke="#E0E0E0"
                                BackgroundColor="#FAFAFA"
                                Padding="12,4">
                            <Picker Title="Todos los estados"
                                    TitleColor="#AAAAAA"
                                    FontSize="13"
                                    BackgroundColor="Transparent">
                                <Picker.Items>
                                    <x:String>Abierto</x:String>
                                    <x:String>En revisión</x:String>
                                    <x:String>Cerrado</x:String>
                                </Picker.Items>
                            </Picker>
                        </Border>
                        <Border Grid.Column="2"
                                StrokeShape="RoundRectangle 8"
                                Stroke="#E0E0E0"
                                BackgroundColor="#FAFAFA"
                                Padding="12,4">
                            <Picker Title="Todas las categorías"
                                    TitleColor="#AAAAAA"
                                    FontSize="13"
                                    BackgroundColor="Transparent">
                                <Picker.Items>
                                    <x:String>Cómputo</x:String>
                                    <x:String>Red</x:String>
                                    <x:String>Impresión</x:String>
                                    <x:String>Electricidad</x:String>
                                </Picker.Items>
                            </Picker>
                        </Border>
                    </Grid>

                    <!-- Encabezado tabla -->
                    <Grid ColumnDefinitions="50,110,*,110,110,100"
                          BackgroundColor="#F0F0F0"
                          Padding="10,8">
                        <Label Grid.Column="0" Text="ID" FontAttributes="Bold" FontSize="13" TextColor="#555" />
                        <Label Grid.Column="1" Text="Equipo" FontAttributes="Bold" FontSize="13" TextColor="#555" />
                        <Label Grid.Column="2" Text="Descripción falla" FontAttributes="Bold" FontSize="13" TextColor="#555" />
                        <Label Grid.Column="3" Text="Fecha" FontAttributes="Bold" FontSize="13" TextColor="#555" />
                        <Label Grid.Column="4" Text="Estado" FontAttributes="Bold" FontSize="13" TextColor="#555" />
                        <Label Grid.Column="5" Text="Acciones" FontAttributes="Bold" FontSize="13" TextColor="#555" />
                    </Grid>

                    <!-- Fila 1 -->
                    <Grid ColumnDefinitions="50,110,*,110,110,100" Padding="10,10" BackgroundColor="White">
                        <Label Grid.Column="0" Text="1" FontSize="13" TextColor="#333" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="EQ-001" FontSize="13" TextColor="#333" VerticalOptions="Center"/>
                        <Label Grid.Column="2" Text="Proyector no enciende" FontSize="13" TextColor="#333" VerticalOptions="Center"/>
                        <Label Grid.Column="3" Text="14/05/2025" FontSize="13" TextColor="#333" VerticalOptions="Center"/>
                        <Border Grid.Column="4"
                                BackgroundColor="#FDECEA"
                                StrokeShape="RoundRectangle 20"
                                Stroke="Transparent"
                                Padding="10,4"
                                HorizontalOptions="Start"
                                VerticalOptions="Center">
                            <Label Text="Abierto" TextColor="#C62828" FontSize="12" FontAttributes="Bold"/>
                        </Border>
                        <Label Grid.Column="5" Text="✏️ 🗑️" FontSize="16" VerticalOptions="Center"/>
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="#F0F0F0"/>

                    <!-- Fila 2 -->
                    <Grid ColumnDefinitions="50,110,*,110,110,100" Padding="10,10" BackgroundColor="White">
                        <Label Grid.Column="0" Text="2" FontSize="13" TextColor="#333" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="EQ-002" FontSize="13" TextColor="#333" VerticalOptions="Center"/>
                        <Label Grid.Column="2" Text="Computadora lenta, posible virus" FontSize="13" TextColor="#333" VerticalOptions="Center"/>
                        <Label Grid.Column="3" Text="16/05/2025" FontSize="13" TextColor="#333" VerticalOptions="Center"/>
                        <Border Grid.Column="4"
                                BackgroundColor="#FFF3CD"
                                StrokeShape="RoundRectangle 20"
                                Stroke="Transparent"
                                Padding="10,4"
                                HorizontalOptions="Start"
                                VerticalOptions="Center">
                            <Label Text="En revisión" TextColor="#856404" FontSize="12" FontAttributes="Bold"/>
                        </Border>
                        <Label Grid.Column="5" Text="✏️ 🗑️" FontSize="16" VerticalOptions="Center"/>
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="#F0F0F0"/>

                    <!-- Fila 3 -->
                    <Grid ColumnDefinitions="50,110,*,110,110,100" Padding="10,10" BackgroundColor="White">
                        <Label Grid.Column="0" Text="3" FontSize="13" TextColor="#333" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="EQ-003" FontSize="13" TextColor="#333" VerticalOptions="Center"/>
                        <Label Grid.Column="2" Text="Impresora sin papel reconocido" FontSize="13" TextColor="#333" VerticalOptions="Center"/>
                        <Label Grid.Column="3" Text="19/05/2025" FontSize="13" TextColor="#333" VerticalOptions="Center"/>
                        <Border Grid.Column="4"
                                BackgroundColor="#D4EDDA"
                                StrokeShape="RoundRectangle 20"
                                Stroke="Transparent"
                                Padding="10,4"
                                HorizontalOptions="Start"
                                VerticalOptions="Center">
                            <Label Text="Cerrado" TextColor="#1E7E34" FontSize="12" FontAttributes="Bold"/>
                        </Border>
                        <Label Grid.Column="5" Text="✏️ 🗑️" FontSize="16" VerticalOptions="Center"/>
                    </Grid>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>