<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ControlEquiposElectronicos.Views.Consultas.ConsultasPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Consultas"
    BackgroundColor="#F5F5F5">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20">

            <VerticalStackLayout Spacing="4">
                <Label Text="Consultas" FontSize="28" FontAttributes="Bold" TextColor="#1A1A2E" />
                <Label Text="Busca y filtra información técnica del sistema" FontSize="14" TextColor="#666666" />
            </VerticalStackLayout>

            <!-- FILTROS -->
            <Border BackgroundColor="White" StrokeShape="RoundRectangle 12" Stroke="#E0E0E0" Padding="20">
                <VerticalStackLayout Spacing="16">

                    <Label Text="Filtros de búsqueda" FontSize="16" FontAttributes="Bold" TextColor="#1A1A2E" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="12">

                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="6">
                            <Label Text="Código de equipo" FontAttributes="Bold" FontSize="13" TextColor="#1A1A2E" />
                            <Border StrokeShape="RoundRectangle 8" Stroke="#E0E0E0" BackgroundColor="#FAFAFA" Padding="12,10">
                                <Entry Placeholder="🔍  Ej: EQ-001"
                                       PlaceholderColor="#AAAAAA"
                                       FontSize="13"
                                       BackgroundColor="Transparent"
                                       Text="{Binding Busqueda}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="6">
                            <Label Text="Categoría" FontAttributes="Bold" FontSize="13" TextColor="#1A1A2E" />
                            <Border StrokeShape="RoundRectangle 8" Stroke="#E0E0E0" BackgroundColor="#FAFAFA" Padding="12,4">
                                <Picker Title="Todas las categorías"
                                        TitleColor="#AAAAAA"
                                        FontSize="13"
                                        BackgroundColor="Transparent"
                                        SelectedItem="{Binding CategoriaFiltro}">
                                    <Picker.Items>
                                        <x:String>Cómputo</x:String>
                                        <x:String>Red</x:String>
                                        <x:String>Impresión</x:String>
                                        <x:String>Electricidad</x:String>
                                    </Picker.Items>
                                </Picker>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="6">
                            <Label Text="Ubicación" FontAttributes="Bold" FontSize="13" TextColor="#1A1A2E" />
                            <Border StrokeShape="RoundRectangle 8" Stroke="#E0E0E0" BackgroundColor="#FAFAFA" Padding="12,4">
                                <Picker Title="Todas las ubicaciones"
                                        TitleColor="#AAAAAA"
                                        FontSize="13"
                                        BackgroundColor="Transparent"
                                        SelectedItem="{Binding UbicacionFiltro}">
                                    <Picker.Items>
                                        <x:String>Aula 101</x:String>
                                        <x:String>Laboratorio 2</x:String>
                                        <x:String>Secretaría</x:String>
                                        <x:String>Dirección</x:String>
                                    </Picker.Items>
                                </Picker>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="6">
                            <Label Text="Estado" FontAttributes="Bold" FontSize="13" TextColor="#1A1A2E" />
                            <Border StrokeShape="RoundRectangle 8" Stroke="#E0E0E0" BackgroundColor="#FAFAFA" Padding="12,4">
                                <Picker Title="Todos los estados"
                                        TitleColor="#AAAAAA"
                                        FontSize="13"
                                        BackgroundColor="Transparent"
                                        SelectedItem="{Binding EstadoFiltro}">
                                    <Picker.Items>
                                        <x:String>Activo</x:String>
                                        <x:String>En mantenimiento</x:String>
                                        <x:String>Inactivo</x:String>
                                    </Picker.Items>
                                </Picker>
                            </Border>
                        </VerticalStackLayout>

                    </Grid>

                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#4F8EF7" HorizontalOptions="Center" />

                    <Border BackgroundColor="#4F8EF7" StrokeShape="RoundRectangle 8" Stroke="Transparent" Padding="0">
                        <Button Text="🔍  Buscar"
                                BackgroundColor="#4F8EF7"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="15"
                                Command="{Binding BuscarCommand}" />
                    </Border>

                </VerticalStackLayout>
            </Border>

            <!-- RESULTADOS -->
            <Border BackgroundColor="White" StrokeShape="RoundRectangle 12" Stroke="#E0E0E0" Padding="20">
                <VerticalStackLayout Spacing="16">

                    <Label Text="Resultados" FontSize="18" FontAttributes="Bold" TextColor="#1A1A2E" />

                    <Grid ColumnDefinitions="50,110,*,110,110" BackgroundColor="#F0F0F0" Padding="10,8">
                        <Label Grid.Column="0" Text="ID" FontAttributes="Bold" FontSize="13" TextColor="#555" />
                        <Label Grid.Column="1" Text="Código" FontAttributes="Bold" FontSize="13" TextColor="#555" />
                        <Label Grid.Column="2" Text="Tipo / Categoría" FontAttributes="Bold" FontSize="13" TextColor="#555" />
                        <Label Grid.Column="3" Text="Ubicación" FontAttributes="Bold" FontSize="13" TextColor="#555" />
                        <Label Grid.Column="4" Text="Estado" FontAttributes="Bold" FontSize="13" TextColor="#555" />
                    </Grid>

                    <CollectionView ItemsSource="{Binding Resultados}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="50,110,*,110,110" Padding="10,10">
                                    <Label Grid.Column="0" Text="{Binding Id}" FontSize="13" TextColor="#333" VerticalOptions="Center"/>
                                    <Label Grid.Column="1" Text="{Binding Codigo}" FontSize="13" TextColor="#333" VerticalOptions="Center"/>
                                    <Label Grid.Column="2" Text="{Binding Tipo}" FontSize="13" TextColor="#333" VerticalOptions="Center"/>
                                    <Label Grid.Column="3" Text="{Binding Ubicacion}" FontSize="13" TextColor="#333" VerticalOptions="Center"/>
                                    <Border Grid.Column="4"
                                            BackgroundColor="#D4EDDA"
                                            StrokeShape="RoundRectangle 20"
                                            Stroke="Transparent"
                                            Padding="10,4"
                                            HorizontalOptions="Start"
                                            VerticalOptions="Center">
                                        <Label Text="{Binding Estado}" TextColor="#1E7E34" FontSize="12" FontAttributes="Bold"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>