<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ControlEquiposElectronicos.Views.Consultas.ConsultasPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dto="clr-namespace:ControlEquiposElectronicos.DTOs.Equipos"
    Title="Consultas"
    BackgroundColor="#F5F5F5">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20">

            <VerticalStackLayout Spacing="4">
                <Label Text="Consultas" FontSize="28" FontAttributes="Bold" TextColor="#1A1A2E" />
                <Label Text="Busca y filtra equipos según inventario, reportes y mantenimientos"
                       FontSize="14" TextColor="#666666" />
            </VerticalStackLayout>

            <Border BackgroundColor="#FFF3CD" StrokeShape="RoundRectangle 10" Stroke="#FFC107"
                    Padding="14,10" IsVisible="{Binding ErrorConexion}">
                <Label Text="{Binding MensajeEstado}" FontSize="12" TextColor="#856404" />
            </Border>

            <!-- FILTROS -->
            <Border BackgroundColor="White" StrokeShape="RoundRectangle 12" Stroke="#E0E0E0" Padding="20">
                <VerticalStackLayout Spacing="16">

                    <Label Text="Filtros de búsqueda" FontSize="16" FontAttributes="Bold" TextColor="#1A1A2E" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto" RowSpacing="12">

                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="6">
                            <Label Text="Código o nombre" FontAttributes="Bold" FontSize="13" TextColor="#1A1A2E" />
                            <Border StrokeShape="RoundRectangle 8" Stroke="#E0E0E0" BackgroundColor="#FAFAFA" Padding="12,10">
                                <Entry Placeholder="🔍  Código, nombre, marca..."
                                       PlaceholderColor="#AAAAAA"
                                       FontSize="13"
                                       BackgroundColor="Transparent"
                                       Text="{Binding Busqueda}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="6">
                            <Label Text="Categoría" FontAttributes="Bold" FontSize="13" TextColor="#1A1A2E" />
                            <Border StrokeShape="RoundRectangle 8" Stroke="#E0E0E0" BackgroundColor="#FAFAFA" Padding="12,4">
                                <Picker Title="Todas las categorías"
                                        TitleColor="#AAAAAA"
                                        FontSize="13"
                                        BackgroundColor="Transparent"
                                        ItemsSource="{Binding Categorias}"
                                        ItemDisplayBinding="{Binding Nombre}"
                                        SelectedItem="{Binding CategoriaSeleccionada}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="6">
                            <Label Text="Ubicación" FontAttributes="Bold" FontSize="13" TextColor="#1A1A2E" />
                            <Border StrokeShape="RoundRectangle 8" Stroke="#E0E0E0" BackgroundColor="#FAFAFA" Padding="12,4">
                                <Picker Title="Todas las ubicaciones"
                                        TitleColor="#AAAAAA"
                                        FontSize="13"
                                        BackgroundColor="Transparent"
                                        ItemsSource="{Binding Ubicaciones}"
                                        ItemDisplayBinding="{Binding Nombre}"
                                        SelectedItem="{Binding UbicacionSeleccionada}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="6">
                            <Label Text="Estado" FontAttributes="Bold" FontSize="13" TextColor="#1A1A2E" />
                            <Border StrokeShape="RoundRectangle 8" Stroke="#E0E0E0" BackgroundColor="#FAFAFA" Padding="12,4">
                                <Picker Title="Todos los estados"
                                        TitleColor="#AAAAAA"
                                        FontSize="13"
                                        BackgroundColor="Transparent"
                                        ItemsSource="{Binding Estados}"
                                        ItemDisplayBinding="{Binding Nombre}"
                                        SelectedItem="{Binding EstadoSeleccionado}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="2" Grid.ColumnSpan="2" Spacing="8">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                    <Label Text="Con reportes o mantenimientos en fechas"
                                           FontAttributes="Bold" FontSize="13" TextColor="#1A1A2E" />
                                    <Label Text="Muestra solo equipos con actividad en el rango indicado"
                                           FontSize="11" TextColor="#888888" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1" IsToggled="{Binding FiltrarPorActividad}"
                                        OnColor="#4F8EF7" VerticalOptions="Center" />
                            </Grid>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12"
                                  IsVisible="{Binding MostrarFiltroFechas}">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Desde" FontAttributes="Bold" FontSize="12" TextColor="#1A1A2E" />
                                    <DatePicker Date="{Binding FechaDesde}" Format="dd/MM/yyyy"
                                                BackgroundColor="#FAFAFA" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Hasta" FontAttributes="Bold" FontSize="12" TextColor="#1A1A2E" />
                                    <DatePicker Date="{Binding FechaHasta}" Format="dd/MM/yyyy"
                                                BackgroundColor="#FAFAFA" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>

                    </Grid>

                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                       Color="#4F8EF7" HorizontalOptions="Center" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Border Grid.Column="0" BackgroundColor="#4F8EF7" StrokeShape="RoundRectangle 8" Stroke="Transparent" Padding="0">
                            <Button Text="🔍  Buscar"
                                    BackgroundColor="#4F8EF7"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    FontSize="15"
                                    Command="{Binding BuscarCommand}" />
                        </Border>
                        <Border Grid.Column="1" BackgroundColor="#F5F5F5" StrokeShape="RoundRectangle 8" Stroke="#E0E0E0" Padding="0">
                            <Button Text="Limpiar filtros"
                                    BackgroundColor="#F5F5F5"
                                    TextColor="#666666"
                                    FontSize="14"
                                    Command="{Binding LimpiarFiltrosCommand}" />
                        </Border>
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- RESULTADOS -->
            <Border BackgroundColor="White" StrokeShape="RoundRectangle 12" Stroke="#E0E0E0" Padding="20">
                <VerticalStackLayout Spacing="16">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Resultados" FontSize="18" FontAttributes="Bold" TextColor="#1A1A2E" />
                        <Label Grid.Column="1" Text="{Binding TotalResultados, StringFormat='{0} registro(s)'}"
                               FontSize="13" TextColor="#4F8EF7" VerticalOptions="Center" />
                    </Grid>

                    <Label Text="{Binding MensajeEstado}" FontSize="12" TextColor="#888888"
                           IsVisible="{Binding SinResultados}" />

                    <Grid ColumnDefinitions="50,100,*,100,100,90" BackgroundColor="#F0F0F0" Padding="10,8">
                        <Label Grid.Column="0" Text="ID" FontAttributes="Bold" FontSize="12" TextColor="#555" />
                        <Label Grid.Column="1" Text="Código" FontAttributes="Bold" FontSize="12" TextColor="#555" />
                        <Label Grid.Column="2" Text="Nombre / Categoría" FontAttributes="Bold" FontSize="12" TextColor="#555" />
                        <Label Grid.Column="3" Text="Ubicación" FontAttributes="Bold" FontSize="12" TextColor="#555" />
                        <Label Grid.Column="4" Text="Tipo" FontAttributes="Bold" FontSize="12" TextColor="#555" />
                        <Label Grid.Column="5" Text="Estado" FontAttributes="Bold" FontSize="12" TextColor="#555" />
                    </Grid>

                    <CollectionView ItemsSource="{Binding Resultados}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="dto:EquipoListadoDto">
                                <Grid ColumnDefinitions="50,100,*,100,100,90" Padding="10,10">
                                    <Label Grid.Column="0" Text="{Binding Id}" FontSize="12" TextColor="#333" VerticalOptions="Center"/>
                                    <Label Grid.Column="1" Text="{Binding Codigo}" FontSize="12" TextColor="#333" VerticalOptions="Center"/>
                                    <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Nombre}" FontSize="12" FontAttributes="Bold" TextColor="#1A1A2E" LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding Categoria}" FontSize="11" TextColor="#888888"/>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="3" Text="{Binding Ubicacion}" FontSize="12" TextColor="#333" VerticalOptions="Center"/>
                                    <Label Grid.Column="4" Text="{Binding Tipo}" FontSize="12" TextColor="#333" VerticalOptions="Center"/>
                                    <Border Grid.Column="5"
                                            BackgroundColor="#D4EDDA"
                                            StrokeShape="RoundRectangle 20"
                                            Stroke="Transparent"
                                            Padding="8,4"
                                            HorizontalOptions="Start"
                                            VerticalOptions="Center">
                                        <Label Text="{Binding Estado}" TextColor="#1E7E34" FontSize="11" FontAttributes="Bold"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
