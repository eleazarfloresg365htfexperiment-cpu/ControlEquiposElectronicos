<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ControlEquiposElectronicos.Views.Login.RegistroUsuarioPage"
    Title=""
    Shell.NavBarIsVisible="False"
    BackgroundColor="#EEF0F6">

    <Grid Padding="24">

        <!-- Fondo suave -->
        <BoxView BackgroundColor="#33000000"/>

        <!-- Tarjeta centrada -->
        <Border
            BackgroundColor="White"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 24"
            WidthRequest="520"
            MaximumHeightRequest="760"
            HorizontalOptions="Center"
            VerticalOptions="Center">

            <Border.Shadow>
                <Shadow Brush="#40000000"
                        Offset="0,8"
                        Radius="32"
                        Opacity="0.45"/>
            </Border.Shadow>

            <ScrollView>
                <VerticalStackLayout Padding="32,32,32,34" Spacing="0">

                    <!-- ENCABEZADO -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Nuevo usuario"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="#1A1F3A"/>

                            <Label Text="Completa los datos para crear una cuenta de acceso al sistema."
                                   FontSize="13"
                                   TextColor="#9AA3BE"/>
                        </VerticalStackLayout>

                        <!-- Botón X -->
                        <Border Grid.Column="1"
                                BackgroundColor="#F5F3FC"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="0"
                                WidthRequest="38"
                                HeightRequest="38"
                                VerticalOptions="Start">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnVolverClicked"/>
                            </Border.GestureRecognizers>

                            <Label FontFamily="FontAwesome"
                                   Text="&#xf00d;"
                                   FontSize="14"
                                   TextColor="#9AA3BE"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>
                    </Grid>

                    <BoxView HeightRequest="1"
                             BackgroundColor="#F0EDF9"
                             Margin="0,18,0,24"/>

                    <!-- NOMBRE COMPLETO -->
                    <VerticalStackLayout Spacing="6" Margin="0,0,0,16">
                        <Label Text="Nombre completo"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#4A5270"
                               CharacterSpacing="0.3"/>

                        <Border BackgroundColor="#F8F7FC"
                                StrokeShape="RoundRectangle 12"
                                Stroke="#E8E4F8"
                                StrokeThickness="1"
                                Padding="14,0">

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Grid.Column="0"
                                       FontFamily="FontAwesome"
                                       Text="&#xf007;"
                                       FontSize="13"
                                       TextColor="#C4B5FD"
                                       VerticalOptions="Center"/>

                                <Entry Grid.Column="1"
                                       x:Name="NombreEntry"
                                       Placeholder="Ej. Juan Pérez"
                                       TextColor="#1A1F3A"
                                       PlaceholderColor="#C4C9D8"
                                       HeightRequest="48"
                                       BackgroundColor="Transparent"/>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- NOMBRE DE USUARIO -->
                    <VerticalStackLayout Spacing="6" Margin="0,0,0,16">
                        <Label Text="Nombre de usuario"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#4A5270"
                               CharacterSpacing="0.3"/>

                        <Border BackgroundColor="#F8F7FC"
                                StrokeShape="RoundRectangle 12"
                                Stroke="#E8E4F8"
                                StrokeThickness="1"
                                Padding="14,0">

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Grid.Column="0"
                                       FontFamily="FontAwesome"
                                       Text="&#xf406;"
                                       FontSize="13"
                                       TextColor="#C4B5FD"
                                       VerticalOptions="Center"/>

                                <Entry Grid.Column="1"
                                       x:Name="NicknameEntry"
                                       Placeholder="Ej. jperez"
                                       TextColor="#1A1F3A"
                                       PlaceholderColor="#C4C9D8"
                                       HeightRequest="48"
                                       BackgroundColor="Transparent"/>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- CORREO -->
                    <VerticalStackLayout Spacing="6" Margin="0,0,0,16">
                        <Label Text="Correo electrónico"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#4A5270"
                               CharacterSpacing="0.3"/>

                        <Border BackgroundColor="#F8F7FC"
                                StrokeShape="RoundRectangle 12"
                                Stroke="#E8E4F8"
                                StrokeThickness="1"
                                Padding="14,0">

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Grid.Column="0"
                                       FontFamily="FontAwesome"
                                       Text="&#xf0e0;"
                                       FontSize="13"
                                       TextColor="#C4B5FD"
                                       VerticalOptions="Center"/>

                                <Entry Grid.Column="1"
                                       x:Name="CorreoEntry"
                                       Placeholder="Ej. jperez@cpc.com"
                                       Keyboard="Email"
                                       TextColor="#1A1F3A"
                                       PlaceholderColor="#C4C9D8"
                                       HeightRequest="48"
                                       BackgroundColor="Transparent"/>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- TELÉFONO -->
                    <VerticalStackLayout Spacing="6" Margin="0,0,0,16">
                        <Label Text="Teléfono"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#4A5270"
                               CharacterSpacing="0.3"/>

                        <Border BackgroundColor="#F8F7FC"
                                StrokeShape="RoundRectangle 12"
                                Stroke="#E8E4F8"
                                StrokeThickness="1"
                                Padding="14,0">

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Grid.Column="0"
                                       FontFamily="FontAwesome"
                                       Text="&#xf095;"
                                       FontSize="13"
                                       TextColor="#C4B5FD"
                                       VerticalOptions="Center"/>

                                <Entry Grid.Column="1"
                                       x:Name="TelefonoEntry"
                                       Placeholder="Ej. 1234-5678"
                                       Keyboard="Telephone"
                                       TextColor="#1A1F3A"
                                       PlaceholderColor="#C4C9D8"
                                       HeightRequest="48"
                                       BackgroundColor="Transparent"/>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- CONTRASEÑA -->
                    <VerticalStackLayout Spacing="6" Margin="0,0,0,24">
                        <Label Text="Contraseña"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#4A5270"
                               CharacterSpacing="0.3"/>

                        <Border BackgroundColor="#F8F7FC"
                                StrokeShape="RoundRectangle 12"
                                Stroke="#E8E4F8"
                                StrokeThickness="1"
                                Padding="14,0">

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Grid.Column="0"
                                       FontFamily="FontAwesome"
                                       Text="&#xf023;"
                                       FontSize="13"
                                       TextColor="#C4B5FD"
                                       VerticalOptions="Center"/>

                                <Entry Grid.Column="1"
                                       x:Name="ContrasenaEntry"
                                       Placeholder="••••••••"
                                       IsPassword="True"
                                       TextColor="#1A1F3A"
                                       PlaceholderColor="#C4C9D8"
                                       HeightRequest="48"
                                       BackgroundColor="Transparent"/>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- ROL -->
                    <VerticalStackLayout x:Name="SeccionRol" Spacing="10" Margin="0,0,0,28">
                        <Label Text="Rol"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#4A5270"
                               CharacterSpacing="0.3"/>

                        <Button x:Name="BtnAdministrador"
                                Clicked="OnRolAdministrador"
                                Text="Administrador"
                                BackgroundColor="#F8F7FC"
                                TextColor="#4A5270"
                                BorderColor="#E8E4F8"
                                BorderWidth="1"
                                FontSize="13"
                                FontAttributes="Bold"
                                HeightRequest="50"
                                CornerRadius="12">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="FontAwesome"
                                                 Glyph="&#xf505;"
                                                 Color="#C4B5FD"
                                                 Size="14"/>
                            </Button.ImageSource>
                        </Button>

                        <Button x:Name="BtnTecnico"
                                Clicked="OnRolTecnico"
                                Text="Técnico / OP"
                                BackgroundColor="#F8F7FC"
                                TextColor="#4A5270"
                                BorderColor="#E8E4F8"
                                BorderWidth="1"
                                FontSize="13"
                                FontAttributes="Bold"
                                HeightRequest="50"
                                CornerRadius="12">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="FontAwesome"
                                                 Glyph="&#xf0ad;"
                                                 Color="#C4B5FD"
                                                 Size="14"/>
                            </Button.ImageSource>
                        </Button>

                        <Button x:Name="BtnConsulta"
                                Clicked="OnRolConsulta"
                                Text="Consulta"
                                BackgroundColor="#F8F7FC"
                                TextColor="#4A5270"
                                BorderColor="#E8E4F8"
                                BorderWidth="1"
                                FontSize="13"
                                FontAttributes="Bold"
                                HeightRequest="50"
                                CornerRadius="12">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="FontAwesome"
                                                 Glyph="&#xf007;"
                                                 Color="#C4B5FD"
                                                 Size="14"/>
                            </Button.ImageSource>
                        </Button>
                    </VerticalStackLayout>

                    <Switch x:Name="ActivoSwitch"
                            IsToggled="True"
                            IsVisible="False"/>

                    <!-- BOTÓN REGISTRAR -->
                    <Button Text="Registrar usuario"
                            Clicked="OnRegistrarClicked"
                            BackgroundColor="#512BD4"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="14"
                            HeightRequest="52"
                            CornerRadius="14"
                            Margin="0,0,0,10">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="FontAwesome"
                                             Glyph="&#xf234;"
                                             Color="White"
                                             Size="15"/>
                        </Button.ImageSource>
                        <Button.Shadow>
                            <Shadow Brush="#40512BD4"
                                    Offset="0,4"
                                    Radius="14"
                                    Opacity="1"/>
                        </Button.Shadow>
                    </Button>

                    <!-- BOTÓN CANCELAR -->
                    <Button Text="Cancelar"
                            Clicked="OnVolverClicked"
                            BackgroundColor="Transparent"
                            TextColor="#9AA3BE"
                            FontSize="13"
                            HeightRequest="44"
                            CornerRadius="12"
                            BorderColor="#E8E4F8"
                            BorderWidth="1"/>

                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>
</ContentPage>