<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ControlEquiposElectronicos.Views.Login.RegistroUsuarioPage"
    Title="Registro de usuario"
    BackgroundColor="{StaticResource Gray100}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20">

            <Border BackgroundColor="White"
                    StrokeShape="RoundRectangle 12"
                    Stroke="{StaticResource Gray200}"
                    StrokeThickness="1"
                    Padding="24">
                <VerticalStackLayout Spacing="16">

                    <Label Text="Registrar nuevo usuario"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Gray900}" />
                    <Label Text="Completa los datos para crear una cuenta de acceso al sistema."
                           FontSize="13"
                           TextColor="{StaticResource Gray500}" />

                    <!-- Nombre completo -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Nombre completo" FontSize="13" TextColor="{StaticResource Gray500}" />
                        <Border StrokeShape="RoundRectangle 8" Stroke="{StaticResource Gray200}" StrokeThickness="1" Padding="12,0">
                            <Entry x:Name="NombreEntry"
                                   Placeholder="Ej. Juan Pérez"
                                   TextColor="{StaticResource Gray900}"
                                   PlaceholderColor="{StaticResource Gray400}"
                                   HeightRequest="44"
                                   BackgroundColor="Transparent" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Nickname / Usuario -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Nombre de usuario" FontSize="13" TextColor="{StaticResource Gray500}" />
                        <Border StrokeShape="RoundRectangle 8" Stroke="{StaticResource Gray200}" StrokeThickness="1" Padding="12,0">
                            <Entry x:Name="NicknameEntry"
                                   Placeholder="Ej. jperez"
                                   TextColor="{StaticResource Gray900}"
                                   PlaceholderColor="{StaticResource Gray400}"
                                   HeightRequest="44"
                                   BackgroundColor="Transparent" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Correo -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Correo electrónico" FontSize="13" TextColor="{StaticResource Gray500}" />
                        <Border StrokeShape="RoundRectangle 8" Stroke="{StaticResource Gray200}" StrokeThickness="1" Padding="12,0">
                            <Entry x:Name="CorreoEntry"
                                   Placeholder="Ej. jperez@cpc.com"
                                   Keyboard="Email"
                                   TextColor="{StaticResource Gray900}"
                                   PlaceholderColor="{StaticResource Gray400}"
                                   HeightRequest="44"
                                   BackgroundColor="Transparent" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Teléfono -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Teléfono" FontSize="13" TextColor="{StaticResource Gray500}" />
                        <Border StrokeShape="RoundRectangle 8" Stroke="{StaticResource Gray200}" StrokeThickness="1" Padding="12,0">
                            <Entry x:Name="TelefonoEntry"
                                   Placeholder="Ej. 1234-5678"
                                   Keyboard="Telephone"
                                   TextColor="{StaticResource Gray900}"
                                   PlaceholderColor="{StaticResource Gray400}"
                                   HeightRequest="44"
                                   BackgroundColor="Transparent" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Contraseña -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Contraseña" FontSize="13" TextColor="{StaticResource Gray500}" />
                        <Border StrokeShape="RoundRectangle 8" Stroke="{StaticResource Gray200}" StrokeThickness="1" Padding="12,0">
                            <Entry x:Name="ContrasenaEntry"
                                   Placeholder="••••••••"
                                   IsPassword="True"
                                   TextColor="{StaticResource Gray900}"
                                   PlaceholderColor="{StaticResource Gray400}"
                                   HeightRequest="44"
                                   BackgroundColor="Transparent" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Rol -->
                    <VerticalStackLayout x:Name="SeccionRol" Spacing="6">
                        <Label Text="Rol" FontSize="13" TextColor="{StaticResource Gray500}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Grid.Column="0"
                                    x:Name="BtnAdministrador"
                                    Text="Administrador"
                                    Clicked="OnRolAdministrador"
                                    BackgroundColor="{StaticResource Gray100}"
                                    TextColor="{StaticResource Gray900}"
                                    BorderColor="{StaticResource Gray200}"
                                    BorderWidth="1"
                                    HeightRequest="44"
                                    CornerRadius="8" />
                            <Button Grid.Column="1"
                                    x:Name="BtnTecnico"
                                    Text="Técnico"
                                    Clicked="OnRolTecnico"
                                    BackgroundColor="{StaticResource Gray100}"
                                    TextColor="{StaticResource Gray900}"
                                    BorderColor="{StaticResource Gray200}"
                                    BorderWidth="1"
                                    HeightRequest="44"
                                    CornerRadius="8" />
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Activo -->
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Usuario activo" TextColor="{StaticResource Gray900}" />
                            <Label Text="Permite el acceso al sistema" FontSize="12" TextColor="{StaticResource Gray400}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" x:Name="ActivoSwitch" IsToggled="True" OnColor="{StaticResource Primary}" VerticalOptions="Center" />
                    </Grid>

                    <!-- Botón registrar -->
                    <Button Text="Registrar usuario"
                            Clicked="OnRegistrarClicked"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            FontAttributes="Bold"
                            HeightRequest="48"
                            CornerRadius="8"
                            Margin="0,8,0,0" />

                    <Button Text="Volver"
                            Clicked="OnVolverClicked"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource Primary}"
                            HeightRequest="44" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
