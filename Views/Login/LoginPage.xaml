<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ControlEquiposElectronicos.Views.Login.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Login"
    BackgroundColor="{StaticResource Secondary}">

    <Grid>
        <!-- Tarjeta central del login -->
        <Border
            VerticalOptions="Center"
            HorizontalOptions="Center"
            WidthRequest="400"
            Padding="34"
            BackgroundColor="White"
            StrokeShape="RoundRectangle 18"
            StrokeThickness="0">

            <VerticalStackLayout Spacing="18">

                <!-- Logo temporal TechStorm -->
                <Image
    Source="logo_techstorm.png"
    WidthRequest="92"
    HeightRequest="92"
    Aspect="AspectFit"
    HorizontalOptions="Center" />

                <!-- Títulos -->
                <VerticalStackLayout Spacing="2">
                    <Label
                        Text="StormCore"
                        FontSize="24"
                        FontAttributes="Bold"
                        TextColor="{StaticResource Gray900}"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Sistema de gestión de equipos electrónicos"
                        FontSize="13"
                        TextColor="{StaticResource Gray500}"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="by TechStorm"
                        FontSize="12"
                        TextColor="{StaticResource Primary}"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Campo Usuario -->
                <VerticalStackLayout Spacing="6" Margin="0,8,0,0">
                    <Label
                        Text="Usuario"
                        FontSize="13"
                        TextColor="{StaticResource Gray500}" />

                    <Border
                        StrokeShape="RoundRectangle 8"
                        Stroke="{StaticResource Gray200}"
                        StrokeThickness="1"
                        Padding="12,0">

                        <Entry
                            x:Name="UsuarioEntry"
                            Text="{Binding Usuario}"
                            Placeholder="Ej. jperez"
                            TextColor="{StaticResource Gray900}"
                            PlaceholderColor="{StaticResource Gray400}"
                            HeightRequest="44"
                            BackgroundColor="Transparent"
                            ReturnType="Next"
                            Completed="UsuarioEntry_Completed" />
                    </Border>
                </VerticalStackLayout>

                <!-- Campo Contraseña -->
                <VerticalStackLayout Spacing="6">
                    <Label
                        Text="Contraseña"
                        FontSize="13"
                        TextColor="{StaticResource Gray500}" />

                    <Border
                        StrokeShape="RoundRectangle 8"
                        Stroke="{StaticResource Gray200}"
                        StrokeThickness="1"
                        Padding="12,0">

                        <Entry
                            x:Name="ContrasenaEntry"
                            Text="{Binding Contrasena}"
                            Placeholder="••••••••"
                            IsPassword="True"
                            TextColor="{StaticResource Gray900}"
                            PlaceholderColor="{StaticResource Gray400}"
                            HeightRequest="44"
                            BackgroundColor="Transparent"
                            ReturnType="Go"
                            ReturnCommand="{Binding IniciarSesionCommand}" />
                    </Border>
                </VerticalStackLayout>

                <!-- Botón Iniciar sesión -->
                <Button
                    Text="Iniciar sesión"
                    Command="{Binding IniciarSesionCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    FontSize="15"
                    FontAttributes="Bold"
                    HeightRequest="46"
                    CornerRadius="8"
                    Margin="0,8,0,0" />

                <!-- Enlace de registro -->
                <Label
                    Text="¿No tienes cuenta? Regístrate"
                    FontSize="13"
                    FontAttributes="Bold"
                    TextColor="{StaticResource Primary}"
                    HorizontalOptions="Center"
                    Margin="0,8,0,0">

                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding RegistrarseCommand}" />
                    </Label.GestureRecognizers>
                </Label>

            </VerticalStackLayout>
        </Border>
    </Grid>

</ContentPage>