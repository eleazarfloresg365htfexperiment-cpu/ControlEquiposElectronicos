<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ControlEquiposElectronicos.Views.Configuracion.ConfiguracionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title=""
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F5F6FA">

    <ScrollView>
        <VerticalStackLayout Padding="32,28,32,32" Spacing="0">

            <!-- ══════════════════════════════════════════ -->
            <!-- HEADER                                      -->
            <!-- ══════════════════════════════════════════ -->
            <VerticalStackLayout Spacing="4" Margin="0,0,0,28">
                <Label Text="Configuración"
                       FontSize="26" FontAttributes="Bold" TextColor="#1A1F3A"/>
                <Label Text="Gestiona las preferencias y herramientas del sistema"
                       FontSize="14" TextColor="#9AA3BE"/>
            </VerticalStackLayout>

            <!-- ══════════════════════════════════════════ -->
            <!-- ACCESO RESTRINGIDO                          -->
            <!-- ══════════════════════════════════════════ -->
            <Border x:Name="AccesoRestringido"
                    IsVisible="False"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 16"
                    Stroke="#EEEBf8" StrokeThickness="1"
                    Padding="40">
                <Border.Shadow>
                    <Shadow Brush="#10512BD4" Offset="0,4" Radius="16" Opacity="1"/>
                </Border.Shadow>
                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                    <Border BackgroundColor="#EDE9FB" StrokeShape="RoundRectangle 24"
                            StrokeThickness="0" WidthRequest="56" HeightRequest="56"
                            HorizontalOptions="Center">
                        <Label FontFamily="FontAwesome" Text="&#xf023;"
                               FontSize="22" TextColor="#512BD4"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Label Text="Acceso restringido"
                           FontSize="18" FontAttributes="Bold"
                           TextColor="#1A1F3A" HorizontalOptions="Center"/>
                    <Label Text="Solo los administradores pueden acceder a la configuración del sistema."
                           FontSize="13" TextColor="#9AA3BE" HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </Border>

            <!-- ══════════════════════════════════════════ -->
            <!-- CONTENIDO PRINCIPAL                         -->
            <!-- ══════════════════════════════════════════ -->
            <VerticalStackLayout x:Name="ContenidoConfig" IsVisible="False" Spacing="20">

                <!-- ── INFORMACIÓN DE SESIÓN ── -->
                <Border BackgroundColor="White"
                        StrokeShape="RoundRectangle 16"
                        Stroke="#EEEBf8" StrokeThickness="1"
                        Padding="24">
                    <Border.Shadow>
                        <Shadow Brush="#10512BD4" Offset="0,4" Radius="16" Opacity="1"/>
                    </Border.Shadow>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20">

                        <!-- Avatar -->
                        <Border Grid.Column="0"
                                WidthRequest="56" HeightRequest="56"
                                BackgroundColor="#EDE9FB"
                                StrokeShape="RoundRectangle 28"
                                StrokeThickness="2" Stroke="#C4B5FD"
                                VerticalOptions="Center">
                            <Label FontFamily="FontAwesome" Text="&#xf007;"
                                   FontSize="22" TextColor="#512BD4"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>

                        <!-- Datos -->
                        <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                            <Label Text="Información de la sesión"
                                   FontSize="11" FontAttributes="Bold"
                                   TextColor="#9AA3BE" CharacterSpacing="1" Margin="0,0,0,8"/>
                            <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="24">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="USUARIO" FontSize="10" TextColor="#C4C9D8"
                                           FontAttributes="Bold" CharacterSpacing="1"/>
                                    <Label x:Name="NombreLabel" Text="-"
                                           FontSize="15" FontAttributes="Bold" TextColor="#1A1F3A"/>
                                </VerticalStackLayout>
                                <BoxView Grid.Column="1" WidthRequest="1"
                                         BackgroundColor="#EDE9FB" VerticalOptions="Fill"/>
                                <VerticalStackLayout Grid.Column="2" Spacing="2">
                                    <Label Text="ROL" FontSize="10" TextColor="#C4C9D8"
                                           FontAttributes="Bold" CharacterSpacing="1"/>
                                    <HorizontalStackLayout Spacing="8">
                                        <Border BackgroundColor="#EDE9FB"
                                                StrokeShape="RoundRectangle 6"
                                                StrokeThickness="0" Padding="10,4">
                                            <Label x:Name="RolLabel" Text="-"
                                                   FontSize="13" FontAttributes="Bold"
                                                   TextColor="#512BD4"/>
                                        </Border>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- ── FILA: AJUSTES + ADMINISTRACIÓN + SISTEMA ── -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">

                    <!-- AJUSTES GENERALES (oculto; preferencias pendientes de API) -->
                    <Border x:Name="SeccionAjustesGenerales"
                            Grid.Column="0" WidthRequest="260"
                            IsVisible="False"
                            BackgroundColor="White"
                            StrokeShape="RoundRectangle 16"
                            Stroke="#EEEBf8" StrokeThickness="1"
                            Padding="22">
                        <Border.Shadow>
                            <Shadow Brush="#10512BD4" Offset="0,4" Radius="16" Opacity="1"/>
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="0">
                            <Label Text="Ajustes generales"
                                   FontSize="15" FontAttributes="Bold" TextColor="#1A1F3A"/>
                            <Label Text="Preferencias de la aplicación"
                                   FontSize="11" TextColor="#9AA3BE" Margin="0,2,0,18"/>

                            <!-- Notificaciones (oculto) -->
                            <Border x:Name="AjusteNotificaciones"
                                    IsVisible="False"
                                    BackgroundColor="#FAFAFA"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="#F0EDF9" StrokeThickness="1"
                                    Padding="14,12" Margin="0,0,0,10">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Grid.Column="0"
                                            BackgroundColor="#EDE9FB"
                                            StrokeShape="RoundRectangle 10"
                                            StrokeThickness="0"
                                            WidthRequest="36" HeightRequest="36">
                                        <Label FontFamily="FontAwesome" Text="&#xf0f3;"
                                               FontSize="14" TextColor="#512BD4"
                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                        <Label Text="Notificaciones"
                                               FontSize="13" FontAttributes="Bold" TextColor="#1A1F3A"/>
                                        <Label Text="Recibir avisos del sistema"
                                               FontSize="11" TextColor="#9AA3BE"/>
                                    </VerticalStackLayout>
                                    <Switch Grid.Column="2" IsToggled="True"
                                            OnColor="#512BD4" VerticalOptions="Center"/>
                                </Grid>
                            </Border>

                            <!-- Confirmar antes de eliminar (oculto) -->
                            <Border x:Name="AjusteConfirmarEliminar"
                                    IsVisible="False"
                                    BackgroundColor="#FAFAFA"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="#F0EDF9" StrokeThickness="1"
                                    Padding="14,12">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Grid.Column="0"
                                            BackgroundColor="#FEE2E2"
                                            StrokeShape="RoundRectangle 10"
                                            StrokeThickness="0"
                                            WidthRequest="36" HeightRequest="36">
                                        <Label FontFamily="FontAwesome" Text="&#xf071;"
                                               FontSize="14" TextColor="#991B1B"
                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                        <Label Text="Confirmar antes de eliminar"
                                               FontSize="13" FontAttributes="Bold" TextColor="#1A1F3A"/>
                                        <Label Text="Pedir confirmación en acciones críticas"
                                               FontSize="11" TextColor="#9AA3BE"/>
                                    </VerticalStackLayout>
                                    <Switch Grid.Column="2" IsToggled="True"
                                            OnColor="#512BD4" VerticalOptions="Center"/>
                                </Grid>
                            </Border>

                        </VerticalStackLayout>
                    </Border>

                    <!-- ADMINISTRACIÓN -->
                    <Border Grid.Column="0"
                            BackgroundColor="White"
                            StrokeShape="RoundRectangle 16"
                            Stroke="#EEEBf8" StrokeThickness="1"
                            Padding="22">
                        <Border.Shadow>
                            <Shadow Brush="#10512BD4" Offset="0,4" Radius="16" Opacity="1"/>
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="0">
                            <Label Text="Administración"
                                   FontSize="15" FontAttributes="Bold" TextColor="#1A1F3A"/>
                            <Label Text="Herramientas administrativas"
                                   FontSize="11" TextColor="#9AA3BE" Margin="0,2,0,18"/>

                            <!-- Card: Registrar nuevo usuario -->
                            <Border BackgroundColor="#FAFAFA"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="#F0EDF9" StrokeThickness="1"
                                    Padding="16,14" Margin="0,0,0,10">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRegistrarUsuarioClicked"/>
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                    <Border Grid.Column="0"
                                            BackgroundColor="#EDE9FB"
                                            StrokeShape="RoundRectangle 12"
                                            StrokeThickness="0"
                                            WidthRequest="44" HeightRequest="44">
                                        <Label FontFamily="FontAwesome" Text="&#xf234;"
                                               FontSize="17" TextColor="#512BD4"
                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="Registrar nuevo usuario"
                                               FontSize="13" FontAttributes="Bold" TextColor="#1A1F3A"/>
                                        <Label Text="Crear un nuevo usuario en el sistema"
                                               FontSize="11" TextColor="#9AA3BE"/>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" FontFamily="FontAwesome" Text="&#xf054;"
                                           FontSize="12" TextColor="#C4B5FD" VerticalOptions="Center"/>
                                </Grid>
                            </Border>

                            <!-- Card: Gestionar permisos por rol (oculto; acceso vía ruta PermisosRol) -->
                            <Border x:Name="CardPermisosRol"
                                    IsVisible="False"
                                    BackgroundColor="#FAFAFA"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="#F0EDF9" StrokeThickness="1"
                                    Padding="16,14" Margin="0,0,0,10">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPermisosClicked"/>
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                    <Border Grid.Column="0"
                                            BackgroundColor="#EDE9FB"
                                            StrokeShape="RoundRectangle 12"
                                            StrokeThickness="0"
                                            WidthRequest="44" HeightRequest="44">
                                        <Label FontFamily="FontAwesome" Text="&#xf084;"
                                               FontSize="17" TextColor="#512BD4"
                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="Gestionar permisos por rol"
                                               FontSize="13" FontAttributes="Bold" TextColor="#1A1F3A"/>
                                        <Label Text="Administrar permisos de funciones por cada rol"
                                               FontSize="11" TextColor="#9AA3BE"/>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" FontFamily="FontAwesome" Text="&#xf054;"
                                           FontSize="12" TextColor="#C4B5FD" VerticalOptions="Center"/>
                                </Grid>
                            </Border>

                            <!-- Card: Gestionar roles por usuario -->
                            <Border BackgroundColor="#FAFAFA"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="#F0EDF9" StrokeThickness="1"
                                    Padding="16,14">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnGestionarRolesUsuarioClicked"/>
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                    <Border Grid.Column="0"
                                            BackgroundColor="#EDE9FB"
                                            StrokeShape="RoundRectangle 12"
                                            StrokeThickness="0"
                                            WidthRequest="44" HeightRequest="44">
                                        <Label FontFamily="FontAwesome" Text="&#xf0c0;"
                                               FontSize="17" TextColor="#512BD4"
                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="Gestionar roles por usuario"
                                               FontSize="13" FontAttributes="Bold" TextColor="#1A1F3A"/>
                                        <Label Text="Asignar y administrar roles para cada usuario"
                                               FontSize="11" TextColor="#9AA3BE"/>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" FontFamily="FontAwesome" Text="&#xf054;"
                                           FontSize="12" TextColor="#C4B5FD" VerticalOptions="Center"/>
                                </Grid>
                            </Border>

                        </VerticalStackLayout>
                    </Border>

                    <!-- SISTEMA (auditoría) -->
                    <Border x:Name="SeccionAuditoria"
                            Grid.Column="1" WidthRequest="220"
                            IsVisible="False"
                            BackgroundColor="White"
                            StrokeShape="RoundRectangle 16"
                            Stroke="#EEEBf8" StrokeThickness="1"
                            Padding="22">
                        <Border.Shadow>
                            <Shadow Brush="#10512BD4" Offset="0,4" Radius="16" Opacity="1"/>
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="0">
                            <Label Text="Sistema"
                                   FontSize="15" FontAttributes="Bold" TextColor="#1A1F3A"/>
                            <Label Text="Herramientas del sistema"
                                   FontSize="11" TextColor="#9AA3BE" Margin="0,2,0,18"/>

                            <!-- Card auditoría -->
                            <Border BackgroundColor="#FAFAFA"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="#F0EDF9" StrokeThickness="1"
                                    Padding="16,14">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnAuditoriaClicked"/>
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Grid.Column="0"
                                            BackgroundColor="#EDE9FB"
                                            StrokeShape="RoundRectangle 10"
                                            StrokeThickness="0"
                                            WidthRequest="40" HeightRequest="40">
                                        <Label FontFamily="FontAwesome" Text="&#xf46d;"
                                               FontSize="16" TextColor="#512BD4"
                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="Ver auditoría del sistema"
                                               FontSize="12" FontAttributes="Bold" TextColor="#1A1F3A"/>
                                        <Label Text="Consultar cambios y actividades del sistema"
                                               FontSize="10" TextColor="#9AA3BE"/>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" FontFamily="FontAwesome" Text="&#xf054;"
                                           FontSize="12" TextColor="#C4B5FD" VerticalOptions="Center"/>
                                </Grid>
                            </Border>

                        </VerticalStackLayout>
                    </Border>

                </Grid>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
