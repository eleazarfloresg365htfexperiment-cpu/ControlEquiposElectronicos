<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ControlEquiposElectronicos.Views.Configuracion.PerfilUsuarioPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Mi Perfil"
    BackgroundColor="{StaticResource Gray100}">

    <Grid RowDefinitions="Auto,*">

        <!-- Botón volver fijo arriba -->
        <Button Grid.Row="0"
                Text="← Volver"
                Clicked="OnVolverClicked"
                BackgroundColor="Transparent"
                TextColor="{StaticResource Primary}"
                FontAttributes="Bold"
                FontSize="14"
                HorizontalOptions="Start"
                Padding="24,8"
                HeightRequest="40" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="0">

                <!-- Cabecera morada -->
                <Grid HeightRequest="180" BackgroundColor="{StaticResource Primary}">
                    <Ellipse Fill="#3A1F8F" WidthRequest="180" HeightRequest="180" HorizontalOptions="End" VerticalOptions="Start" Margin="0,-60,-60,0" Opacity="0.5" />
                    <Ellipse Fill="#3A1F8F" WidthRequest="120" HeightRequest="120" HorizontalOptions="Start" VerticalOptions="End" Margin="-40,0,0,10" Opacity="0.35" />

                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                        <Border WidthRequest="72" HeightRequest="72" HorizontalOptions="Center" BackgroundColor="White" StrokeShape="RoundRectangle 36" StrokeThickness="3" Stroke="{StaticResource Secondary}">
                            <Label x:Name="InicialesLabel" Text="??" TextColor="{StaticResource Primary}" FontSize="26" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label x:Name="NombreCompletoLabel" Text="Cargando..." TextColor="White" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Grid>

                <VerticalStackLayout Padding="20,20,20,0" Spacing="16">

                    <!-- Información de la cuenta -->
                    <Border BackgroundColor="White" StrokeShape="RoundRectangle 14" Stroke="{StaticResource Gray200}" StrokeThickness="1" Padding="20">
                        <VerticalStackLayout Spacing="16">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Border Grid.Column="0" BackgroundColor="{StaticResource Secondary}" StrokeShape="RoundRectangle 8" StrokeThickness="0" WidthRequest="36" HeightRequest="36">
                                    <Label FontFamily="FontAwesome" Text="&#xf2bd;" TextColor="{StaticResource Primary}" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Grid.Column="1" Text="Información de la cuenta" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Gray900}" VerticalOptions="Center" />
                            </Grid>
                            <BoxView HeightRequest="1" BackgroundColor="{StaticResource Gray200}" Margin="0,-4,0,0" />

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                <Border Grid.Column="0" BackgroundColor="#F3F0FD" StrokeShape="RoundRectangle 8" StrokeThickness="0" WidthRequest="40" HeightRequest="40">
                                    <Label FontFamily="FontAwesome" Text="&#xf007;" TextColor="{StaticResource Primary}" FontSize="15" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="Nombre completo" FontSize="12" TextColor="{StaticResource Gray500}" />
                                    <Label x:Name="NombreInfoLabel" Text="-" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Gray900}" />
                                </VerticalStackLayout>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                <Border Grid.Column="0" BackgroundColor="#F3F0FD" StrokeShape="RoundRectangle 8" StrokeThickness="0" WidthRequest="40" HeightRequest="40">
                                    <Label FontFamily="FontAwesome" Text="&#xf505;" TextColor="{StaticResource Primary}" FontSize="15" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="Rol asignado" FontSize="12" TextColor="{StaticResource Gray500}" />
                                    <Label x:Name="RolInfoLabel" Text="-" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Gray900}" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Permisos activos -->
                    <Border BackgroundColor="White" StrokeShape="RoundRectangle 14" Stroke="{StaticResource Gray200}" StrokeThickness="1" Padding="20">
                        <VerticalStackLayout Spacing="14">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Border Grid.Column="0" BackgroundColor="{StaticResource Secondary}" StrokeShape="RoundRectangle 8" StrokeThickness="0" WidthRequest="36" HeightRequest="36">
                                    <Label FontFamily="FontAwesome" Text="&#xf023;" TextColor="{StaticResource Primary}" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Grid.Column="1" Text="Permisos activos" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Gray900}" VerticalOptions="Center" />
                            </Grid>
                            <BoxView HeightRequest="1" BackgroundColor="{StaticResource Gray200}" Margin="0,-4,0,0" />
                            <VerticalStackLayout x:Name="PermisosContainer" Spacing="8" />
                            <Label x:Name="SinPermisosLabel" Text="No tienes permisos asignados." FontSize="14" TextColor="{StaticResource Gray500}" HorizontalOptions="Center" IsVisible="False" />
                        </VerticalStackLayout>
                    </Border>

                    <BoxView HeightRequest="24" BackgroundColor="Transparent" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
