<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ControlEquiposElectronicos.Views.Configuracion.PerfilUsuarioPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Mi Perfil"
    BackgroundColor="{StaticResource Gray100}">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- ══════════════════════════════════════════════ -->
            <!-- CABECERA con gradiente morado                  -->
            <!-- ══════════════════════════════════════════════ -->
            <Grid HeightRequest="200"
                  BackgroundColor="{StaticResource Primary}">

                <!-- Círculo decorativo superior-derecha -->
                <Ellipse
                    Fill="#3A1F8F"
                    WidthRequest="180"
                    HeightRequest="180"
                    HorizontalOptions="End"
                    VerticalOptions="Start"
                    Margin="0,-60,-60,0"
                    Opacity="0.5" />

                <!-- Círculo decorativo inferior-izquierda -->
                <Ellipse
                    Fill="#3A1F8F"
                    WidthRequest="120"
                    HeightRequest="120"
                    HorizontalOptions="Start"
                    VerticalOptions="End"
                    Margin="-40,0,0,10"
                    Opacity="0.35" />

                <!-- Contenido centrado de la cabecera -->
                <VerticalStackLayout
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Spacing="10">

                    <!-- Avatar con iniciales -->
                    <Border
                        WidthRequest="80"
                        HeightRequest="80"
                        HorizontalOptions="Center"
                        BackgroundColor="White"
                        StrokeShape="RoundRectangle 40"
                        StrokeThickness="3"
                        Stroke="#DFD8F7">
                        <Label
                            x:Name="InicialesLabel"
                            Text="??"
                            TextColor="{StaticResource Primary}"
                            FontSize="28"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>

                    <!-- Nombre completo -->
                    <Label
                        x:Name="NombreCompletoLabel"
                        Text="Cargando..."
                        TextColor="White"
                        FontSize="20"
                        FontAttributes="Bold"
                        HorizontalOptions="Center" />

                </VerticalStackLayout>
            </Grid>

            <!-- ══════════════════════════════════════════════ -->
            <!-- TARJETA: Información de la cuenta             -->
            <!-- ══════════════════════════════════════════════ -->
            <VerticalStackLayout Padding="20,20,20,0" Spacing="16">

                <Border BackgroundColor="White"
                        StrokeShape="RoundRectangle 14"
                        Stroke="{StaticResource Gray200}"
                        StrokeThickness="1"
                        Padding="20">
                    <VerticalStackLayout Spacing="16">

                        <!-- Título de sección -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Border Grid.Column="0"
                                    BackgroundColor="{StaticResource Secondary}"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0"
                                    WidthRequest="36"
                                    HeightRequest="36">
                                <Label
                                    FontFamily="FontAwesome"
                                    Text="&#xf2bd;"
                                    TextColor="{StaticResource Primary}"
                                    FontSize="16"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1"
                                   Text="Información de la cuenta"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Gray900}"
                                   VerticalOptions="Center" />
                        </Grid>

                        <!-- Separador -->
                        <BoxView HeightRequest="1"
                                 BackgroundColor="{StaticResource Gray200}"
                                 Margin="0,-4,0,0" />

                        <!-- Fila: Nombre -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Border Grid.Column="0"
                                    BackgroundColor="#F3F0FD"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0"
                                    WidthRequest="40"
                                    HeightRequest="40">
                                <Label
                                    FontFamily="FontAwesome"
                                    Text="&#xf007;"
                                    TextColor="{StaticResource Primary}"
                                    FontSize="15"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="Nombre completo"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray500}" />
                                <Label x:Name="NombreInfoLabel"
                                       Text="-"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Gray900}" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Fila: Rol -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Border Grid.Column="0"
                                    BackgroundColor="#F3F0FD"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0"
                                    WidthRequest="40"
                                    HeightRequest="40">
                                <Label
                                    FontFamily="FontAwesome"
                                    Text="&#xf505;"
                                    TextColor="{StaticResource Primary}"
                                    FontSize="15"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="Rol asignado"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray500}" />
                                <Label x:Name="RolInfoLabel"
                                       Text="-"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Gray900}" />
                            </VerticalStackLayout>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- ══════════════════════════════════════════ -->
                <!-- TARJETA: Permisos activos                  -->
                <!-- ══════════════════════════════════════════ -->
                <Border BackgroundColor="White"
                        StrokeShape="RoundRectangle 14"
                        Stroke="{StaticResource Gray200}"
                        StrokeThickness="1"
                        Padding="20">
                    <VerticalStackLayout Spacing="14">

                        <!-- Título de sección -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Border Grid.Column="0"
                                    BackgroundColor="{StaticResource Secondary}"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0"
                                    WidthRequest="36"
                                    HeightRequest="36">
                                <Label
                                    FontFamily="FontAwesome"
                                    Text="&#xf023;"
                                    TextColor="{StaticResource Primary}"
                                    FontSize="16"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1"
                                   Text="Permisos activos"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Gray900}"
                                   VerticalOptions="Center" />
                        </Grid>

                        <!-- Separador -->
                        <BoxView HeightRequest="1"
                                 BackgroundColor="{StaticResource Gray200}"
                                 Margin="0,-4,0,0" />

                        <!-- Lista de permisos generada por código -->
                        <VerticalStackLayout x:Name="PermisosContainer" Spacing="8" />

                        <!-- Estado vacío (si no tiene permisos) -->
                        <Label x:Name="SinPermisosLabel"
                               Text="No tienes permisos asignados."
                               FontSize="14"
                               TextColor="{StaticResource Gray500}"
                               HorizontalOptions="Center"
                               IsVisible="False" />

                    </VerticalStackLayout>
                </Border>

                <!-- Espacio inferior -->
                <BoxView HeightRequest="24" BackgroundColor="Transparent" />

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
