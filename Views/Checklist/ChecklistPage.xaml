<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ControlEquiposElectronicos.Views.Checklist.ChecklistPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ControlEquiposElectronicos.ViewModels.Checklist"
    x:DataType="vm:ChecklistViewModel"
    Title="{Binding Title}">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="16" RowSpacing="12">

        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <Label Text="Checklist técnico" FontSize="24" FontAttributes="Bold" />
            <Label Text="Checklist en proceso. Toca uno para continuar la revisión." FontSize="13" TextColor="Gray" />
        </VerticalStackLayout>

        <Label Grid.Row="1"
               Text="{Binding MensajeError}"
               TextColor="IndianRed"
               IsVisible="{Binding TieneError}" />

        <RefreshView Grid.Row="2"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding CargarCommand}">
            <CollectionView x:Name="ChecklistsCollection"
                            ItemsSource="{Binding ChecklistsEnProceso}"
                            SelectionMode="Single"
                            SelectionChanged="OnChecklistSeleccionado"
                            EmptyView="No hay checklist en proceso. Crea uno nuevo.">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChecklistResumenItem">
                        <Border Padding="14" Margin="0,0,0,10" StrokeThickness="1" Stroke="{StaticResource Gray200}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Ubicacion}" FontAttributes="Bold" FontSize="16" />
                                <Label Text="{Binding Tecnico, StringFormat='Técnico: {0}'}" FontSize="13" />
                                <Label Text="{Binding EstadoChecklist, StringFormat='Estado: {0}'}" FontSize="13" />
                                <Label Text="{Binding ProgresoTexto}" FontSize="13" TextColor="{StaticResource Primary}" />
                                <Label Text="{Binding FechaInicio, StringFormat='Inicio: {0:g}'}" FontSize="12" TextColor="Gray" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <VerticalStackLayout Grid.Row="3" Spacing="8">
            <Button Text="Nuevo checklist" Command="{Binding NuevoCommand}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Grid.Column="0" Text="Historial" Command="{Binding HistorialCommand}" />
                <Button Grid.Column="1" Text="Plantillas" Command="{Binding PlantillasCommand}" BackgroundColor="{StaticResource Secondary}" />
            </Grid>
        </VerticalStackLayout>

        <ActivityIndicator Grid.Row="2"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
    </Grid>
</ContentPage>
