<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ControlEquiposElectronicos.Views.Checklist.HistorialChecklistPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ControlEquiposElectronicos.ViewModels.Checklist"
    x:DataType="vm:HistorialChecklistViewModel"
    Title="{Binding Title}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16" RowSpacing="12">
        <Label Grid.Row="0"
               Text="{Binding MensajeError}"
               TextColor="IndianRed"
               IsVisible="{Binding TieneError}" />

        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding CargarCommand}">
            <CollectionView ItemsSource="{Binding Historial}"
                            EmptyView="Aún no hay checklist finalizados o cancelados.">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChecklistResumenItem">
                        <Border Padding="14" Margin="0,0,0,10" StrokeThickness="1" Stroke="{StaticResource Gray200}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Ubicacion}" FontAttributes="Bold" FontSize="16" />
                                <Label Text="{Binding Tecnico, StringFormat='Técnico: {0}'}" FontSize="13" />
                                <Label Text="{Binding EstadoChecklist, StringFormat='Estado: {0}'}" FontSize="13" />
                                <Label Text="{Binding ProgresoTexto}" FontSize="13" />
                                <Label Text="{Binding FechaInicio, StringFormat='Inicio: {0:g}'}" FontSize="12" TextColor="Gray" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Button Grid.Row="2" Text="Volver" Clicked="OnVolverClicked" />
        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
    </Grid>
</ContentPage>
