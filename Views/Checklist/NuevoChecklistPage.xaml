<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ControlEquiposElectronicos.Views.Checklist.NuevoChecklistPage"
    Title="Nuevo checklist"
    BackgroundColor="{StaticResource Gray100}">

    <ContentPage.Resources>
        <Style x:Key="ChecklistEditor" TargetType="Editor">
            <Setter Property="TextColor" Value="{StaticResource Gray900}" />
            <Setter Property="PlaceholderColor" Value="{StaticResource Gray500}" />
        </Style>
        <Style x:Key="ChecklistPicker" TargetType="Picker">
            <Setter Property="TextColor" Value="{StaticResource Gray900}" />
            <Setter Property="TitleColor" Value="{StaticResource Gray500}" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14">
            <Label Text="Nuevo checklist"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Gray900}" />
            <Label Text="{Binding PasoActualTexto}"
                   FontSize="13"
                   TextColor="{StaticResource Gray500}" />

            <!-- Paso 1: Ubicación -->
            <Border BackgroundColor="White"
                    Stroke="{StaticResource Gray200}"
                    StrokeShape="RoundRectangle 12"
                    Padding="16">
                <VerticalStackLayout Spacing="10">
                    <HorizontalStackLayout Spacing="8">
                        <Border WidthRequest="28" HeightRequest="28"
                                BackgroundColor="{StaticResource Primary}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 14">
                            <Label Text="1"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                        <Label Text="Ubicación a revisar"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               TextColor="{StaticResource Gray900}" />
                    </HorizontalStackLayout>

                    <Picker Title="Selecciona una ubicación"
                            Style="{StaticResource ChecklistPicker}"
                            ItemsSource="{Binding Ubicaciones}"
                            ItemDisplayBinding="{Binding Nombre}"
                            SelectedItem="{Binding UbicacionSeleccionada}" />

                    <Button Text="Ver equipos de la ubicación"
                            Clicked="OnPrepararClicked"
                            IsEnabled="{Binding PuedePreparar}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            CornerRadius="10" />
                </VerticalStackLayout>
            </Border>

            <!-- Resumen tras preparar -->
            <Border BackgroundColor="#EEF4FF"
                    Stroke="#3F7AE0"
                    StrokeShape="RoundRectangle 12"
                    Padding="14"
                    IsVisible="{Binding MostrarResumenPreparacion}">
                <Label Text="{Binding ResumenPreparacion}"
                       TextColor="{StaticResource Gray900}"
                       FontSize="13" />
            </Border>

            <!-- Paso 2: Técnico e iniciar -->
            <Border BackgroundColor="White"
                    Stroke="{StaticResource Gray200}"
                    StrokeShape="RoundRectangle 12"
                    Padding="16">
                <VerticalStackLayout Spacing="10">
                    <HorizontalStackLayout Spacing="8">
                        <Border WidthRequest="28" HeightRequest="28"
                                BackgroundColor="#1D7A46"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 14">
                            <Label Text="2"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                        <Label Text="Iniciar revisión"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               TextColor="{StaticResource Gray900}" />
                    </HorizontalStackLayout>

                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="4">
                        <Label Grid.Row="0" Grid.Column="0"
                               Text="Técnico:"
                               TextColor="{StaticResource Gray500}" />
                        <Label Grid.Row="0" Grid.Column="1"
                               Text="{Binding TecnicoNombre}"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Gray900}" />
                        <Label Grid.Row="1" Grid.Column="0"
                               Text="ID en sistema:"
                               FontSize="12"
                               TextColor="{StaticResource Gray500}" />
                        <Label Grid.Row="1" Grid.Column="1"
                               Text="{Binding TecnicoId}"
                               FontSize="12"
                               TextColor="{StaticResource Gray500}" />
                    </Grid>

                    <Label Text="Observaciones (opcional)"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Gray900}" />
                    <Editor Text="{Binding ObservacionesGenerales}"
                            Style="{StaticResource ChecklistEditor}"
                            Placeholder="Ej: Revisión semanal, turno mañana…"
                            AutoSize="TextChanges"
                            HeightRequest="70" />

                    <Button Text="Iniciar checklist"
                            Clicked="OnIniciarClicked"
                            IsEnabled="{Binding PuedeIniciar}"
                            BackgroundColor="#1D7A46"
                            TextColor="White"
                            CornerRadius="10" />
                    <Label Text="{Binding MotivoIniciarDeshabilitado}"
                           FontSize="11"
                           TextColor="#E24B4A"
                           IsVisible="{Binding MostrarMotivoIniciarDeshabilitado}" />
                    <Label Text="Disponible después de ver los equipos y si al menos uno está «Listo» (plantilla con aspectos)."
                           FontSize="11"
                           TextColor="{StaticResource Gray500}" />
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center"
                               Color="{StaticResource Primary}" />

            <Label Text="Equipos de la ubicación"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Gray900}" />

            <CollectionView ItemsSource="{Binding EquiposPreparados}">
                <CollectionView.EmptyView>
                    <Border BackgroundColor="White"
                            Stroke="{StaticResource Gray200}"
                            StrokeShape="RoundRectangle 10"
                            Padding="14">
                        <Label Text="Aquí aparecerán los equipos cuando completes el paso 1."
                               TextColor="{StaticResource Gray500}" />
                    </Border>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="White"
                                Stroke="{StaticResource Gray200}"
                                StrokeShape="RoundRectangle 12"
                                Padding="14"
                                Margin="0,0,0,10">
                            <VerticalStackLayout Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding NombreEquipo}"
                                           FontAttributes="Bold"
                                           FontSize="15"
                                           TextColor="{StaticResource Gray900}" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="0">
                                        <Label Text="Listo"
                                               IsVisible="{Binding ListoParaIniciar}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="#1D7A46"
                                               HorizontalOptions="End" />
                                        <Label Text="Sin aspectos"
                                               IsVisible="{Binding MostrarSinAspectos}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="#F2A400"
                                               HorizontalOptions="End" />
                                        <Label Text="Sin plantilla"
                                               IsVisible="{Binding MostrarSinPlantilla}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="#E24B4A"
                                               HorizontalOptions="End" />
                                    </VerticalStackLayout>
                                </Grid>
                                <Label Text="{Binding CodigoEquipo, StringFormat='Código: {0}'}"
                                       TextColor="{StaticResource Gray500}" />
                                <Label Text="{Binding TipoEquipo, StringFormat='Tipo: {0}'}"
                                       TextColor="{StaticResource Gray500}" />
                                <Label Text="{Binding PlantillaChecklist, StringFormat='Plantilla: {0}'}"
                                       TextColor="{StaticResource Primary}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
